@model WebVanTai.Areas.TicketManager.ViewModels.ManagerDashboardViewModel
@{
    ViewData["Title"] = "Bán Vé Tại Quầy";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-ticket-perforated-fill text-warning me-2"></i>Quản Lý Vé — Bán Vé Tại Quầy</h3>
        <p class="text-muted mb-0 small">Chọn chuyến xe để xuất vé thu tiền mặt hoặc vào Đơn vé để thu tiền các đơn khách đặt online.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Bookings" class="btn btn-outline-dark"><i class="bi bi-receipt me-1"></i>Đơn vé &amp; Thu tiền</a>
        <a asp-action="Tickets" class="btn btn-futa"><i class="bi bi-ticket-detailed me-1"></i>Danh sách vé</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-custom p-3 border-start border-4 border-success">
            <div class="small text-muted fw-semibold text-uppercase">Doanh thu tiền mặt hôm nay</div>
            <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TodayCashRevenue.ToString("N0") đ</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-3 border-start border-4 border-primary">
            <div class="small text-muted fw-semibold text-uppercase">Vé bán tại quầy hôm nay</div>
            <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TodayCounterTicketsSold vé</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-3 border-start border-4 border-warning">
            <div class="small text-muted fw-semibold text-uppercase">Đơn online đang giữ chỗ</div>
            <h3 class="fw-bold text-dark mb-0 mt-1">@Model.PendingBookingsCount đơn</h3>
        </div>
    </div>
</div>

<div class="card card-custom p-3 mb-4">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small fw-semibold text-muted">Tuyến hoặc biển số xe</label>
            <input type="text" name="searchRoute" value="@Model.SearchRoute" class="form-control" placeholder="VD: Đà Lạt, Nha Trang, 51B..." />
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-semibold text-muted">Ngày khởi hành</label>
            <input type="date" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-futa w-100"><i class="bi bi-search me-1"></i>Tìm chuyến</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Mặc định</a>
        </div>
    </form>
</div>

<div class="card card-custom">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Chuyến</th>
                    <th>Tuyến đường</th>
                    <th>Khởi hành</th>
                    <th>Xe &amp; Tổ lái</th>
                    <th>Ghế trống</th>
                    <th>Giá vé</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Trips.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Không có chuyến xe nào phù hợp.</td></tr>
                }
                @foreach (var trip in Model.Trips)
                {
                    <tr>
                        <td class="fw-bold text-muted">#@trip.TripId</td>
                        <td class="fw-bold text-dark">@trip.RouteName</td>
                        <td>
                            <div class="fw-bold text-primary">@trip.DepartureTime.ToString("HH:mm")</div>
                            <small class="text-muted">@trip.DepartureTime.ToString("dd/MM/yyyy")</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border font-monospace">@trip.LicensePlate</span>
                            <div class="small text-muted">@trip.BusTypeName</div>
                            @if (!string.IsNullOrEmpty(trip.DriverName))
                            {
                                <div class="small text-secondary">Tài xế: @trip.DriverName @(string.IsNullOrEmpty(trip.AssistantName) ? "" : $"| Lơ: {trip.AssistantName}")</div>
                            }
                        </td>
                        <td>
                            <span class="badge @(trip.AvailableSeats > 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") fs-6">
                                @trip.AvailableSeats / @trip.TotalSeats
                            </span>
                        </td>
                        <td class="fw-bold text-danger">@trip.BasePrice.ToString("N0") đ</td>
                        <td class="text-end">
                            @if (trip.AvailableSeats > 0)
                            {
                                <a asp-action="Sell" asp-route-tripId="@trip.TripId" class="btn btn-futa btn-sm">
                                    <i class="bi bi-ticket-detailed me-1"></i>Bán vé
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Hết ghế</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
