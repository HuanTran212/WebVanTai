@model WebVanTai.Areas.Admin.ViewModels.StaffCreateViewModel
@{
    ViewData["Title"] = "Thêm Nhân Sự Mới";
    var staffRoles = (string[])ViewBag.StaffRoles!;
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" class="btn btn-light border" title="Quay lại danh sách">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h3 class="fw-bold mb-0 text-dark">
            <i class="bi bi-person-plus-fill text-warning me-2"></i>Thêm Tài Khoản Nhân Sự
        </h3>
        <p class="text-muted small mb-0">Tạo tài khoản đăng nhập cho nhân viên điều hành tuyến hoặc nhân viên soát vé.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-custom">
            <form asp-action="Create" method="post">
                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" placeholder="VD: Nguyễn Văn Soát" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email đăng nhập <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="nhanvien@webvantai.vn" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold">Số điện thoại</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="0901234567" />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Mật khẩu <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control" type="password" placeholder="Tối thiểu 6 ký tự" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Role" class="form-label fw-semibold">Vai trò <span class="text-danger">*</span></label>
                        <div class="row g-2">
                            @foreach (var role in staffRoles)
                            {
                                var desc = role switch
                                {
                                    "Admin" => "Toàn quyền hệ thống + thống kê doanh thu",
                                    "RouteManager" => "Quản lý bến bãi, tuyến xe, lịch chạy",
                                    "TicketInspector" => "Soát vé QR trên di động tại bến",
                                    "TicketManager" => "Quản lý vé: bán vé tại quầy, in vé, hủy/hoàn vé",
                                    _ => ""
                                };
                                var icon = role switch
                                {
                                    "Admin" => "bi-shield-lock-fill",
                                    "RouteManager" => "bi-bus-front-fill",
                                    "TicketInspector" => "bi-qr-code-scan",
                                    "TicketManager" => "bi-ticket-perforated-fill",
                                    _ => "bi-person"
                                };
                                <div class="col-md-6">
                                    <label class="d-block h-100">
                                        <input type="radio" asp-for="Role" value="@role" class="d-none role-radio" />
                                        <div class="role-card p-3 h-100 @(Model.Role == role ? "selected" : "")" data-role="@role">
                                            <i class="bi @icon fs-3 d-block mb-2"></i>
                                            <div class="fw-bold">@role</div>
                                            <div class="small text-muted">@desc</div>
                                        </div>
                                    </label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>
                </div>

                <div class="card-footer bg-white border-top p-3 d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border">Hủy</a>
                    <button type="submit" class="btn btn-futa px-4">
                        <i class="bi bi-check2 me-1"></i>Tạo tài khoản
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .role-card {
            border: 2px solid #E2E8F0;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s;
            text-align: center;
            color: #475569;
        }
        .role-card:hover {
            border-color: #FDBA74;
            background: #FFFBF7;
        }
        .role-card.selected {
            border-color: var(--futa-orange);
            background: #FFF7ED;
            color: var(--futa-orange);
        }
        .role-card.selected .text-muted {
            color: #C2410C !important;
        }
    </style>
}

@section Scripts {
    <script>
        document.querySelectorAll('.role-radio').forEach(function (radio) {
            radio.addEventListener('change', function () {
                document.querySelectorAll('.role-card').forEach(function (card) {
                    card.classList.toggle('selected', card.getAttribute('data-role') === radio.value);
                });
            });
        });
    </script>
}
