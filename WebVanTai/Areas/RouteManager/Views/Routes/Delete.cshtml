@model WebVanTai.Models.Route
@{
    ViewData["Title"] = $"Xóa Tuyến: {Model.StartProvince} - {Model.EndProvince}";
    int tripsCount = ViewBag.TripsCount ?? 0;
    bool canDelete = tripsCount == 0;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-action="Index">Tuyến đường</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xác nhận xóa</li>
        </ol>
    </nav>
    <h3 class="fw-bold text-danger">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác Nhận Xóa Tuyến Đường
    </h3>
    <p class="text-muted small">Kiểm tra thông tin trước khi thực hiện xóa hành trình khỏi cơ sở dữ liệu.</p>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card card-custom p-4">
            @if (!canDelete)
            {
                <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-slash-circle-fill fs-3 me-3"></i>
                    <div>
                        <strong class="d-block mb-1">Không thể xóa tuyến đường này!</strong>
                        Tuyến này hiện đang có <strong>@tripsCount chuyến xe</strong> đang được xếp lịch vận hành. Bạn cần xóa hoặc đổi tuyến cho các chuyến xe đó trước.
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-question-circle-fill fs-3 me-3"></i>
                    <div>
                        Bạn có chắc chắn muốn xóa tuyến đường <strong>@Model.StartProvince - @Model.EndProvince</strong>? Toàn bộ danh sách liên kết trạm dừng của tuyến cũng sẽ bị xóa.
                    </div>
                </div>
            }

            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted">Mã tuyến:</dt>
                <dd class="col-sm-8 fw-bold">#@Model.RouteId</dd>

                <dt class="col-sm-4 text-muted">Tuyến đường:</dt>
                <dd class="col-sm-8 fw-bold text-dark">@Model.StartProvince - @Model.EndProvince</dd>

                <dt class="col-sm-4 text-muted">Cự ly & thời gian:</dt>
                <dd class="col-sm-8">@Model.DistanceKm km &bull; @Model.DurationHours giờ</dd>

                <dt class="col-sm-4 text-muted">Số trạm dừng:</dt>
                <dd class="col-sm-8">@Model.RouteStations.Count trạm</dd>
            </dl>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="RouteId" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger" disabled="@(!canDelete)">
                        <i class="bi bi-trash-fill me-1"></i> Xác Nhận Xóa Tuyến
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy Bỏ & Quay Lại</a>
                </div>
            </form>
        </div>
    </div>
</div>
