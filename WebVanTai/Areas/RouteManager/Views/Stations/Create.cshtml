@model WebVanTai.Models.Station
@{
    ViewData["Title"] = "Thêm Trạm Dừng Mới";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-action="Index">Trạm dừng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
        </ol>
    </nav>
    <h3 class="fw-bold text-dark">
        <i class="bi bi-geo-alt-fill text-danger me-2"></i>Thêm Mới Trạm Dừng / Bến Xe
    </h3>
    <p class="text-muted small">Điền thông tin và nhấp trực tiếp lên bản đồ Leaflet bên dưới để tự động ghi nhận tọa độ GPS.</p>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <!-- Form Inputs -->
        <div class="col-lg-5">
            <div class="card card-custom p-4 h-100">
                <h5 class="fw-bold mb-3 border-bottom pb-2 text-dark">
                    <i class="bi bi-info-circle text-primary me-2"></i>Thông Tin Bến / Trạm
                </h5>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold">Tên Trạm Dừng / Bến Xe <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="Ví dụ: Bến xe Miền Đông Mới" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Province" class="form-label fw-semibold">Tỉnh / Thành Phố <span class="text-danger">*</span></label>
                    <input asp-for="Province" class="form-control" placeholder="Ví dụ: Hồ Chí Minh, Lâm Đồng..." required />
                    <span asp-validation-for="Province" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label fw-semibold">Địa Chỉ Chi Tiết <span class="text-danger">*</span></label>
                    <textarea asp-for="Address" class="form-control" rows="2" placeholder="Số nhà, đường, phường, quận..." required></textarea>
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label asp-for="Latitude" class="form-label fw-semibold">Vĩ Độ (Latitude) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-compass"></i></span>
                            <input asp-for="Latitude" id="latitudeInput" type="number" step="0.000001" class="form-control font-monospace" required />
                        </div>
                        <span asp-validation-for="Latitude" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="Longitude" class="form-label fw-semibold">Kinh Độ (Longitude) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-compass-fill"></i></span>
                            <input asp-for="Longitude" id="longitudeInput" type="number" step="0.000001" class="form-control font-monospace" required />
                        </div>
                        <span asp-validation-for="Longitude" class="text-danger small"></span>
                    </div>
                </div>

                <div class="alert alert-warning py-2 small d-flex align-items-center mb-4">
                    <i class="bi bi-lightbulb-fill text-warning fs-5 me-2"></i>
                    <div>Nhấp chuột lên bản đồ bên phải để tự động điền tọa độ chính xác.</div>
                </div>

                <div class="d-flex gap-2 mt-auto">
                    <button type="submit" class="btn btn-futa flex-grow-1">
                        <i class="bi bi-save me-1"></i> Lưu Trạm Dừng
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy Bỏ</a>
                </div>
            </div>
        </div>

        <!-- Interactive Leaflet Map -->
        <div class="col-lg-7">
            <div class="card card-custom p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2 flex-wrap gap-2">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-map-fill text-success me-2"></i>Bản Đồ Chọn Tọa Độ Leaflet
                    </h5>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-secondary" onclick="panTo(10.776889, 106.700806)">TP.HCM</button>
                        <button type="button" class="btn btn-outline-secondary" onclick="panTo(21.028511, 105.854444)">Hà Nội</button>
                        <button type="button" class="btn btn-outline-secondary" onclick="panTo(16.047079, 108.206230)">Đà Nẵng</button>
                        <button type="button" class="btn btn-outline-secondary" onclick="panTo(11.940419, 108.458313)">Đà Lạt</button>
                        <button type="button" class="btn btn-outline-secondary" onclick="panTo(12.247850, 109.155820)">Nha Trang</button>
                    </div>
                </div>

                <div id="stationMap" class="map-box flex-grow-1" style="min-height: 420px; border-radius: 8px;"></div>
                
                <div class="d-flex justify-content-between align-items-center mt-2 small text-muted">
                    <span><i class="bi bi-cursor-fill text-danger me-1"></i>Nhấp chuột bất kỳ đâu trên bản đồ hoặc kéo ghim để chọn vị trí.</span>
                    <span id="coordDisplay" class="fw-bold text-dark font-monospace">@Model.Latitude, @Model.Longitude</span>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var initialLat = @(Model.Latitude != 0 ? Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture) : "10.776889");
        var initialLng = @(Model.Longitude != 0 ? Model.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture) : "106.700806");

        var map = L.map('stationMap', {
            center: [initialLat, initialLng],
            zoom: 12
        });

        // Layer 1: CartoDB Voyager (dựa trên OpenStreetMap, mượt mà và không bị lỗi DNS ở VN)
        var CARTO_API_KEY = "cb1_5266_1_da1af738d28fe275e205d86e";
        var cartoVoyager = L.tileLayer(
            'https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=' + CARTO_API_KEY,
            {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
                maxZoom: 20
            }
        ).addTo(map);

        // Layer 2: Google Maps
        var googleStreet = L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
            attribution: '&copy; Google Maps',
            maxZoom: 20
        });

        // Layer 3: Esri WorldStreetMap
        var esriStreet = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}', {
            attribution: '&copy; Esri &mdash; National Geographic, DeLorme, NAVTEQ',
            maxZoom: 19
        });

        L.control.layers({
            "Bản đồ OpenStreetMap (CARTO)": cartoVoyager,
            "Bản đồ Google Maps": googleStreet,
            "Bản đồ Esri StreetMap": esriStreet
        }).addTo(map);

        var marker = L.marker([initialLat, initialLng], { draggable: true }).addTo(map);
        marker.bindPopup("<b>Vị trí trạm</b><br>Kéo ghim hoặc nhấp vào bản đồ để chọn tọa độ.").openPopup();

        function updateInputs(lat, lng) {
            var latFixed = lat.toFixed(6);
            var lngFixed = lng.toFixed(6);
            document.getElementById('latitudeInput').value = latFixed;
            document.getElementById('longitudeInput').value = lngFixed;
            document.getElementById('coordDisplay').innerText = latFixed + ", " + lngFixed;
        }

        // Click on map to set position
        map.on('click', function(e) {
            marker.setLatLng(e.latlng);
            updateInputs(e.latlng.lat, e.latlng.lng);
            marker.bindPopup("<b>Đã chọn tọa độ:</b><br>" + e.latlng.lat.toFixed(6) + ", " + e.latlng.lng.toFixed(6)).openPopup();
        });

        // Drag marker
        marker.on('dragend', function(e) {
            var position = marker.getLatLng();
            updateInputs(position.lat, position.lng);
            marker.bindPopup("<b>Đã chọn tọa độ:</b><br>" + position.lat.toFixed(6) + ", " + position.lng.toFixed(6)).openPopup();
        });

        function onManualInput() {
            var lat = parseFloat(document.getElementById('latitudeInput').value);
            var lng = parseFloat(document.getElementById('longitudeInput').value);
            if (!isNaN(lat) && !isNaN(lng)) {
                var newLatLng = new L.LatLng(lat, lng);
                marker.setLatLng(newLatLng);
                map.panTo(newLatLng);
                document.getElementById('coordDisplay').innerText = lat.toFixed(6) + ", " + lng.toFixed(6);
            }
        }
        document.getElementById('latitudeInput').addEventListener('change', onManualInput);
        document.getElementById('longitudeInput').addEventListener('change', onManualInput);

        function panTo(lat, lng) {
            map.flyTo([lat, lng], 13);
            marker.setLatLng([lat, lng]);
            updateInputs(lat, lng);
        }

        setTimeout(function() {
            map.invalidateSize();
        }, 200);

        window.addEventListener('resize', function() {
            map.invalidateSize();
        });
    </script>
}
