@model WebVanTai.Models.Bus
@{
    ViewData["Title"] = $"Xóa Xe: {Model.LicensePlate}";
    int tripsCount = ViewBag.TripsCount ?? 0;
    bool canDelete = tripsCount == 0;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-action="Index">Xe khách</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xác nhận xóa</li>
        </ol>
    </nav>
    <h3 class="fw-bold text-danger">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác Nhận Xóa Xe Khách
    </h3>
    <p class="text-muted small">Kiểm tra thông tin trước khi thực hiện xóa phương tiện khỏi đội xe.</p>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card card-custom p-4">
            @if (!canDelete)
            {
                <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-slash-circle-fill fs-3 me-3"></i>
                    <div>
                        <strong class="d-block mb-1">Không thể xóa xe này!</strong>
                        Phương tiện biển số <strong>@Model.LicensePlate</strong> hiện đang được xếp cho <strong>@tripsCount chuyến xe</strong> trong hệ thống.
                        Bạn phải hủy hoặc đổi xe cho các chuyến đó trước khi xóa.
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-question-circle-fill fs-3 me-3"></i>
                    <div>
                        Bạn có chắc chắn muốn xóa xe biển số <strong>@Model.LicensePlate</strong>? Thao tác này không thể hoàn tác.
                    </div>
                </div>
            }

            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted">Mã xe:</dt>
                <dd class="col-sm-8 fw-bold">#@Model.BusId</dd>

                <dt class="col-sm-4 text-muted">Biển số:</dt>
                <dd class="col-sm-8 fw-bold font-monospace text-dark">@Model.LicensePlate</dd>

                <dt class="col-sm-4 text-muted">Loại xe:</dt>
                <dd class="col-sm-8">@Model.BusType?.Name</dd>

                <dt class="col-sm-4 text-muted">Tiện ích:</dt>
                <dd class="col-sm-8">@Model.Amenities</dd>
            </dl>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BusId" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger" disabled="@(!canDelete)">
                        <i class="bi bi-trash-fill me-1"></i> Xác Nhận Xóa Xe
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy Bỏ & Quay Lại</a>
                </div>
            </form>
        </div>
    </div>
</div>
