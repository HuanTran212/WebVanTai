@model WebVanTai.Models.Bus
@{
    ViewData["Title"] = $"Chi Tiết Xe: {Model.LicensePlate}";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-action="Index">Xe khách</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold text-dark mb-0">
                <i class="bi bi-truck text-info me-2"></i>Xe Khách: @Model.LicensePlate
            </h3>
            <span class="badge bg-light text-secondary border mt-1">Mã xe: #@Model.BusId</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.BusId" class="btn btn-futa btn-sm">
                <i class="bi bi-pencil-square me-1"></i> Chỉnh Sửa
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Quay Lại</a>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Bus Info -->
    <div class="col-lg-5">
        <div class="card card-custom p-4 mb-4">
            <h5 class="fw-bold mb-3 border-bottom pb-2 text-dark">
                <i class="bi bi-info-circle text-primary me-2"></i>Hồ Sơ Phương Tiện
            </h5>
            <dl class="row mb-0">
                <dt class="col-sm-5 text-muted">Biển số xe:</dt>
                <dd class="col-sm-7">
                    <span class="fw-bold font-monospace bg-light border px-2 py-1 rounded">@Model.LicensePlate</span>
                </dd>

                <dt class="col-sm-5 text-muted">Loại xe:</dt>
                <dd class="col-sm-7 fw-semibold text-dark">
                    <a asp-controller="BusTypes" asp-action="Details" asp-route-id="@Model.BusTypeId" class="text-decoration-none">
                        @Model.BusType?.Name
                    </a>
                </dd>

                <dt class="col-sm-5 text-muted">Sức chứa:</dt>
                <dd class="col-sm-7">@Model.BusType?.TotalSeats chỗ &bull; @Model.BusType?.TotalDecks tầng</dd>

                <dt class="col-sm-5 text-muted">Tiện ích:</dt>
                <dd class="col-sm-7">@Model.Amenities</dd>

                <dt class="col-sm-5 text-muted">Trạng thái:</dt>
                <dd class="col-sm-7">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary border">Đang bảo dưỡng</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <!-- Trips with this Bus -->
    <div class="col-lg-7">
        <div class="card card-custom p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-calendar2-range text-warning me-2"></i>Lịch Chạy Của Xe (@Model.Trips.Count)
                </h5>
                <a asp-controller="Trips" asp-action="Create" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus"></i> Xếp Lịch Cho Xe
                </a>
            </div>

            @if (!Model.Trips.Any())
            {
                <div class="alert alert-info small">Xe này chưa được xếp vào chuyến xe nào.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Chuyến</th>
                                <th>Tuyến</th>
                                <th>Khởi Hành</th>
                                <th>Đến Nơi</th>
                                <th>Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var trip in Model.Trips.Take(8))
                            {
                                <tr>
                                    <td class="fw-bold">#@trip.TripId</td>
                                    <td>@trip.Route?.StartProvince - @trip.Route?.EndProvince</td>
                                    <td><small class="fw-semibold">@trip.DepartureTime.ToString("HH:mm dd/MM")</small></td>
                                    <td><small class="text-muted">@trip.ArrivalTime.ToString("HH:mm dd/MM")</small></td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@trip.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
