@model WebVanTai.Models.Trip
@{
    ViewData["Title"] = $"Xóa Chuyến Xe #{Model.TripId}";
    int bookingsCount = ViewBag.BookingsCount ?? 0;
    int ticketsCount = ViewBag.TicketsCount ?? 0;
    bool hasActiveBookings = bookingsCount > 0 || ticketsCount > 0;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-action="Index">Lịch chạy</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xác nhận xóa</li>
        </ol>
    </nav>
    <h3 class="fw-bold text-danger">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác Nhận Xóa Chuyến Xe #@Model.TripId
    </h3>
    <p class="text-muted small">Cân nhắc kỹ trước khi xóa chuyến xe khỏi lịch trình.</p>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card card-custom p-4">
            @if (hasActiveBookings)
            {
                <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-slash-circle-fill fs-3 me-3"></i>
                    <div>
                        <strong class="d-block mb-1">Cảnh báo dữ liệu vé!</strong>
                        Chuyến xe này đã có <strong>@bookingsCount lượt đặt chỗ</strong> và <strong>@ticketsCount vé</strong> phát hành.
                        Để bảo vệ lịch sử giao dịch khách hàng, không nên xóa vật lý. Hãy chuyển trạng thái chuyến thành <code>Cancelled</code> (Đã hủy) trong trang chỉnh sửa.
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-question-circle-fill fs-3 me-3"></i>
                    <div>
                        Bạn có chắc chắn muốn xóa chuyến xe <strong>#@Model.TripId</strong> khỏi lịch vận hành? Thao tác này không thể hoàn tác.
                    </div>
                </div>
            }

            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted">Mã chuyến:</dt>
                <dd class="col-sm-8 fw-bold">#@Model.TripId</dd>

                <dt class="col-sm-4 text-muted">Tuyến xe:</dt>
                <dd class="col-sm-8 fw-bold text-dark">@Model.Route?.StartProvince - @Model.Route?.EndProvince</dd>

                <dt class="col-sm-4 text-muted">Xe phụ trách:</dt>
                <dd class="col-sm-8 font-monospace fw-bold">@Model.Bus?.LicensePlate</dd>

                <dt class="col-sm-4 text-muted">Khởi hành:</dt>
                <dd class="col-sm-8">@Model.DepartureTime.ToString("HH:mm dd/MM/yyyy")</dd>

                <dt class="col-sm-4 text-muted">Đến nơi:</dt>
                <dd class="col-sm-8">@Model.ArrivalTime.ToString("HH:mm dd/MM/yyyy")</dd>

                <dt class="col-sm-4 text-muted">Giá vé:</dt>
                <dd class="col-sm-8 text-danger fw-bold">@Model.BasePrice.ToString("N0") đ</dd>
            </dl>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="TripId" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash-fill me-1"></i> Xác Nhận Xóa Chuyến
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy Bỏ & Quay Lại</a>
                </div>
            </form>
        </div>
    </div>
</div>
