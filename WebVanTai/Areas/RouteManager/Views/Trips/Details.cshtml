@model WebVanTai.Models.Trip
@{
    ViewData["Title"] = $"Chi Tiết Chuyến Xe #{Model.TripId}";
    var totalSeats = Model.Bus?.BusType?.TotalSeats ?? 0;
    var validTickets = Model.Tickets.Where(t => t.Status != TicketStatus.Void).ToList();
    var checkedInTickets = Model.Tickets.Where(t => t.Status == TicketStatus.CheckedIn).ToList();
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-action="Index">Lịch chạy</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết chuyến #@Model.TripId</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold text-dark mb-0">
                <i class="bi bi-calendar2-check text-warning me-2"></i>Chuyến Xe: #@Model.TripId
            </h3>
            <span class="badge bg-light text-secondary border mt-1">
                @Model.Route?.StartProvince <i class="bi bi-arrow-right text-muted small"></i> @Model.Route?.EndProvince
            </span>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.TripId" class="btn btn-futa btn-sm">
                <i class="bi bi-pencil-square me-1"></i> Điều Chỉnh Lịch
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Quay Lại</a>
        </div>
    </div>
</div>

<!-- Key Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="card card-custom p-3">
            <div class="small text-muted fw-semibold">Thời Gian Xuất Bến</div>
            <div class="fs-5 fw-bold text-dark mt-1">@Model.DepartureTime.ToString("HH:mm")</div>
            <div class="small text-secondary">@Model.DepartureTime.ToString("dd/MM/yyyy")</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card card-custom p-3">
            <div class="small text-muted fw-semibold">Thời Gian Đến Dự Kiến</div>
            <div class="fs-5 fw-bold text-dark mt-1">@Model.ArrivalTime.ToString("HH:mm")</div>
            <div class="small text-secondary">@Model.ArrivalTime.ToString("dd/MM/yyyy")</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card card-custom p-3">
            <div class="small text-muted fw-semibold">Tỷ Lệ Đặt Chỗ</div>
            <div class="fs-5 fw-bold text-primary mt-1">@validTickets.Count / @totalSeats chỗ</div>
            <div class="small text-secondary">@checkedInTickets.Count khách đã soát vé</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card card-custom p-3">
            <div class="small text-muted fw-semibold">Giá Vé / Trạng Thái</div>
            <div class="fs-5 fw-bold text-danger mt-1">@Model.BasePrice.ToString("N0") đ</div>
            <div>
                @switch (Model.Status)
                {
                    case TripStatus.Scheduled:
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Lên lịch</span>
                        break;
                    case TripStatus.Running:
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Đang chạy</span>
                        break;
                    case TripStatus.Completed:
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Hoàn thành</span>
                        break;
                    case TripStatus.Cancelled:
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Đã hủy</span>
                        break;
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Route & Bus Details -->
    <div class="col-lg-5">
        <!-- Bus Info Card -->
        <div class="card card-custom p-4 mb-4">
            <h5 class="fw-bold mb-3 border-bottom pb-2 text-dark">
                <i class="bi bi-truck text-info me-2"></i>Phương Tiện Vận Hành
            </h5>
            <dl class="row mb-0">
                <dt class="col-sm-5 text-muted">Biển số xe:</dt>
                <dd class="col-sm-7">
                    <span class="fw-bold font-monospace bg-light border px-2 py-1 rounded">@Model.Bus?.LicensePlate</span>
                </dd>

                <dt class="col-sm-5 text-muted">Dòng xe:</dt>
                <dd class="col-sm-7 fw-semibold">@Model.Bus?.BusType?.Name</dd>

                <dt class="col-sm-5 text-muted">Cấu hình:</dt>
                <dd class="col-sm-7">@Model.Bus?.BusType?.TotalSeats chỗ &bull; @Model.Bus?.BusType?.TotalDecks tầng</dd>

                <dt class="col-sm-5 text-muted">Tiện ích:</dt>
                <dd class="col-sm-7 small">@Model.Bus?.Amenities</dd>
            </dl>
        </div>

        <!-- Route Stations Timeline -->
        <div class="card card-custom p-4">
            <h5 class="fw-bold mb-3 border-bottom pb-2 text-dark">
                <i class="bi bi-signpost-split text-warning me-2"></i>Các Trạm Dừng Tuyến Xe
            </h5>
            @if (Model.Route?.RouteStations != null && Model.Route.RouteStations.Any())
            {
                <ul class="list-group list-group-flush">
                    @foreach (var rs in Model.Route.RouteStations.OrderBy(s => s.StopOrder))
                    {
                        var stopTime = Model.DepartureTime.AddMinutes(rs.OffsetMinutes);
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-secondary me-2">#@rs.StopOrder</span>
                                <span class="fw-semibold text-dark">@rs.Station?.Name</span>
                                <div class="small text-muted ps-4">
                                    Dự kiến: <span class="text-dark fw-bold">@stopTime.ToString("HH:mm dd/MM")</span> (+@rs.OffsetMinutes phút)
                                </div>
                            </div>
                            <span class="badge bg-light text-secondary border">@rs.StationType</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted small mb-0">Tuyến chưa được gán trạm dừng.</p>
            }
        </div>
    </div>

    <!-- Right Column: Tickets & Bookings on this Trip -->
    <div class="col-lg-7">
        <div class="card card-custom p-4 h-100">
            <h5 class="fw-bold mb-3 border-bottom pb-2 text-dark">
                <i class="bi bi-ticket-perforated text-danger me-2"></i>Hành Khách & Vé Đã Đặt (@validTickets.Count vé)
            </h5>

            @if (!validTickets.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-ticket-detailed fs-1 text-secondary mb-2 d-block"></i>
                    Chưa có hành khách nào đặt vé cho chuyến này.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã Vé</th>
                                <th>Số Ghế</th>
                                <th>Hành Khách</th>
                                <th>Số Điện Thoại</th>
                                <th>Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ticket in validTickets)
                            {
                                <tr>
                                    <td class="fw-bold">#@ticket.TicketId</td>
                                    <td>
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle font-monospace fs-6">
                                            @ticket.SeatCode
                                        </span>
                                    </td>
                                    <td class="fw-semibold text-dark">@ticket.PassengerName</td>
                                    <td class="font-monospace small">@ticket.PassengerPhone</td>
                                    <td>
                                        @switch (ticket.Status)
                                        {
                                            case TicketStatus.Valid:
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Hợp lệ</span>
                                                break;
                                            case TicketStatus.CheckedIn:
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Đã lên xe</span>
                                                break;
                                            case TicketStatus.Void:
                                                <span class="badge bg-secondary-subtle text-secondary border">Đã hủy</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
