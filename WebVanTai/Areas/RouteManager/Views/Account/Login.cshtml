@{
    ViewData["Title"] = "Đăng Nhập Quản Trị Tuyến";
    Layout = null; // Standalone clean login page
    var returnUrl = ViewBag.ReturnUrl as string ?? "/RouteManager/Dashboard";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng Nhập - Hệ Thống Điều Hành WebVanTai</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --futa-orange: #F26522;
            --futa-orange-hover: #D95413;
        }
        body {
            background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            padding: 1.5rem;
        }
        .login-card {
            width: 100%;
            max-width: 440px;
            background: #FFFFFF;
            border-radius: 16px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }
        .login-header {
            background-color: var(--futa-orange);
            color: #FFFFFF;
            padding: 2rem 1.5rem;
            text-align: center;
        }
        .btn-futa {
            background-color: var(--futa-orange);
            color: #FFFFFF;
            border: none;
            font-weight: 600;
            padding: 0.75rem;
            transition: background-color 0.2s;
        }
        .btn-futa:hover {
            background-color: var(--futa-orange-hover);
            color: #FFFFFF;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-header">
            <div class="fs-1 mb-2"><i class="bi bi-bus-front-fill"></i></div>
            <h4 class="fw-bold mb-1">WebVanTai</h4>
            <div class="small opacity-75">Hệ Thống Quản Lý Tuyến & Lịch Trình</div>
        </div>

        <div class="p-4">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 small mb-3">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div><i class="bi bi-exclamation-circle-fill me-1"></i> @error.ErrorMessage</div>
                    }
                </div>
            }

            <form method="post" action="/Identity/Account/Login">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Địa Chỉ Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                        <input type="email" name="email" id="emailInput" class="form-control" placeholder="routemanager@webvantai.vn" value="routemanager@webvantai.vn" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Mật Khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                        <input type="password" name="password" id="passwordInput" class="form-control" placeholder="••••••••" value="P@ssword123" required />
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="rememberMe" id="rememberMe" checked />
                        <label class="form-check-label small" for="rememberMe">Ghi nhớ đăng nhập</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-futa w-100 rounded-pill mb-3">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập Hệ Thống
                </button>
            </form>

            <div class="position-relative my-3 text-center">
                <hr class="text-muted" />
                <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">hoặc thử nghiệm nhanh</span>
            </div>

            <!-- Quick 1-click login buttons for testing -->
            <div class="d-grid gap-2">
                <a href="@Url.Action("QuickLogin", "Account", new { area = "RouteManager", role = "RouteManager", returnUrl })" 
                   class="btn btn-outline-warning text-dark btn-sm text-start d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-person-badge-fill text-warning me-2"></i>Đăng nhập nhanh: <strong>RouteManager</strong></span>
                    <i class="bi bi-arrow-right"></i>
                </a>
                <a href="@Url.Action("QuickLogin", "Account", new { area = "RouteManager", role = "Admin", returnUrl })" 
                   class="btn btn-outline-primary btn-sm text-start d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-shield-lock-fill text-primary me-2"></i>Đăng nhập nhanh: <strong>Admin</strong></span>
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="text-center mt-4">
                <a href="/" class="small text-muted text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Quay về trang chủ khách hàng
                </a>
            </div>
        </div>
    </div>
</body>
</html>
