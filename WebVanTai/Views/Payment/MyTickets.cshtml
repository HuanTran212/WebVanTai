@model List<WebVanTai.Models.ViewModels.TicketHistoryViewModel>
@{
    ViewData["Title"] = "Lịch sử vé của tôi";
}

<style>
    :root { --futa-orange: #F26522; --futa-dark: #d9531e; --futa-light: #fff2eb; }

    .page-hero {
        background: linear-gradient(135deg, var(--futa-orange), #ff7e40);
        border-radius: 20px;
        padding: 28px 32px;
        color: #fff;
        margin-bottom: 28px;
    }

    .booking-card {
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,.06);
        border: none;
        overflow: hidden;
        margin-bottom: 24px;
        transition: transform .2s;
    }
    .booking-card:hover { transform: translateY(-3px); }

    .booking-header {
        background: var(--futa-light);
        border-bottom: 2px solid rgba(242,101,34,.2);
        padding: 14px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }

    .status-badge {
        padding: 4px 14px;
        border-radius: 50px;
        font-weight: 700;
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .5px;
    }
    .status-paid     { background: #d4edda; color: #155724; }
    .status-cancelled { background: #f8d7da; color: #721c24; }
    .status-expired  { background: #fff3cd; color: #856404; }
    .status-pending  { background: #cff4fc; color: #055160; }

    .btn-pay {
        background: var(--futa-orange);
        border: 2px solid var(--futa-orange);
        color: #fff;
        border-radius: 10px;
        font-weight: 700;
        padding: 8px 18px;
        transition: all .2s;
    }
    .btn-pay:hover { background: var(--futa-dark); border-color: var(--futa-dark); color: #fff; }

    .ticket-row {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 16px 20px;
        border-bottom: 1px dashed #e2e8f0;
        flex-wrap: wrap;
    }
    .ticket-row:last-child { border-bottom: none; }

    .qr-thumb {
        width: 120px;
        height: 120px;
        border-radius: 8px;
        border: 2px solid var(--futa-orange);
        cursor: pointer;
        transition: transform .2s;
        flex-shrink: 0;
    }
    .qr-thumb:hover { transform: scale(1.05); }

    .seat-badge {
        background: var(--futa-orange);
        color: #fff;
        border-radius: 8px;
        padding: 4px 12px;
        font-weight: 700;
    }

    .qr-placeholder {
        width: 120px; height: 120px;
        border-radius: 8px;
        border: 2px dashed #ccc;
        display: flex; align-items: center; justify-content: center;
        background: #f8f9fa;
        flex-shrink: 0;
    }

    .btn-cancel {
        background: #fff;
        border: 2px solid #dc3545;
        color: #dc3545;
        border-radius: 10px;
        font-weight: 700;
        padding: 8px 18px;
        transition: all .2s;
    }
    .btn-cancel:hover { background: #dc3545; color: #fff; }

    /* Modal phóng to QR */
    #qrModal .modal-content { border-radius: 16px; }
    #qrModalImg { width: 100%; max-width: 300px; display: block; margin: auto; }

    /* Ticket status icon */
    .ticket-status-valid     { color: #28a745; }
    .ticket-status-checkedin { color: #0d6efd; }
    .ticket-status-void      { color: #dc3545; }
    .ticket-status-pending   { color: var(--futa-orange); }
</style>

<div class="container py-4" style="max-width: 800px;">

    <!-- Hero -->
    <div class="page-hero">
        <h4 class="fw-bold mb-1"><i class="bi bi-ticket-perforated me-2"></i>Lịch sử vé của tôi</h4>
        <p class="mb-0 opacity-75">Xuất trình mã QR cho nhân viên soát vé khi lên xe</p>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted"></i>
            <h5 class="mt-3 text-muted">Bạn chưa có vé nào</h5>
            <a asp-controller="Home" asp-action="Index" class="btn mt-3" style="background:var(--futa-orange);color:#fff;border-radius:12px;padding:10px 24px;">
                <i class="bi bi-search me-1"></i> Tìm chuyến xe
            </a>
        </div>
    }
    else
    {
        @foreach (var booking in Model)
        {
            <div class="booking-card card">
                <!-- Booking header -->
                <div class="booking-header">
                    <div>
                        <span class="fw-bold text-dark me-2">#@booking.BookingId</span>
                        <span class="text-muted small">@booking.RouteName</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        @{
                            var (badgeClass, badgeLabel) = booking.Status switch
                            {
                                WebVanTai.Models.Enums.BookingStatus.Pending   => ("status-pending", "Đang giữ chỗ"),
                                WebVanTai.Models.Enums.BookingStatus.Paid      => ("status-paid", "Đã thanh toán"),
                                WebVanTai.Models.Enums.BookingStatus.Cancelled => ("status-cancelled", "Đã hủy"),
                                WebVanTai.Models.Enums.BookingStatus.Expired   => ("status-expired", "Hết hạn"),
                                _                                               => ("status-expired", "Đang xử lý")
                            };
                        }
                        <span class="status-badge @badgeClass">@badgeLabel</span>

                        @if (booking.Status == WebVanTai.Models.Enums.BookingStatus.Pending)
                        {
                            <a class="btn-pay btn" href="/Payment/Pay?bookingId=@booking.BookingId"
                               title="Ghế được giữ tối đa 10 phút kể từ lúc đặt">
                                <i class="bi bi-credit-card-2-front me-1"></i>Thanh toán ngay
                            </a>
                        }

                        @if (booking.CanCancel)
                        {
                            <button type="button"
                                    class="btn-cancel btn"
                                    data-bs-toggle="modal"
                                    data-bs-target="#cancelModal"
                                    data-booking-id="@booking.BookingId"
                                    data-route="@booking.RouteName">
                                <i class="bi bi-x-circle me-1"></i>Hủy vé
                            </button>
                        }
                    </div>
                </div>

                <!-- Trip info summary -->
                <div class="px-4 pt-3 pb-1 bg-white d-flex gap-4 flex-wrap">
                    <div>
                        <small class="text-muted d-block">Giờ xuất bến</small>
                        <strong class="text-primary">@booking.DepartureTime.ToLocalTime().ToString("HH:mm - dd/MM/yyyy")</strong>
                    </div>
                    <div>
                        <small class="text-muted d-block">Điểm đón</small>
                        <strong>@booking.PickupStationName</strong>
                    </div>
                    <div>
                        <small class="text-muted d-block">Điểm trả</small>
                        <strong>@booking.DropoffStationName</strong>
                    </div>
                    <div class="ms-auto">
                        <small class="text-muted d-block">Tổng tiền</small>
                        <strong class="text-danger fs-5">@booking.TotalAmount.ToString("N0") đ</strong>
                    </div>
                </div>

                <!-- Ticket list with QR -->
                @foreach (var ticket in booking.Tickets)
                {
                    <div class="ticket-row">
                        <!-- QR Image -->
                        @if (!string.IsNullOrEmpty(ticket.QrToken) && ticket.Status != WebVanTai.Models.Enums.TicketStatus.Void
                             && booking.Status == WebVanTai.Models.Enums.BookingStatus.Paid)
                        {
                            <img src="/Payment/QrImage?token=@ticket.QrToken"
                                 alt="QR @ticket.SeatCode"
                                 class="qr-thumb"
                                 title="Nhấn để phóng to"
                                 data-qr-token="@ticket.QrToken"
                                 data-seat="@ticket.SeatCode"
                                 onclick="openQrModal(this)" />
                        }
                        else
                        {
                            <div class="qr-placeholder">
                                <i class="bi bi-qr-code fs-2 text-muted"></i>
                            </div>
                        }

                        <!-- Ticket info -->
                        <div class="flex-grow-1">
                            <div class="mb-1">
                                <span class="seat-badge me-2">Ghế @ticket.SeatCode</span>
                                @{
                                    var (statusCss, iconGlyph, statusText) = booking.Status == WebVanTai.Models.Enums.BookingStatus.Pending
                                        ? ("ticket-status-pending", "bi-clock-fill", "Chờ thanh toán")
                                        : ticket.Status switch
                                        {
                                            WebVanTai.Models.Enums.TicketStatus.Valid     => ("ticket-status-valid", "bi-check-circle-fill", "Hợp lệ"),
                                            WebVanTai.Models.Enums.TicketStatus.CheckedIn => ("ticket-status-checkedin", "bi-person-check-fill", "Đã lên xe"),
                                            _                                              => ("ticket-status-void", "bi-x-circle-fill", "Đã hủy")
                                        };
                                }
                                <i class="bi @iconGlyph me-1"></i>
                                <small class="@statusCss">@statusText</small>
                            </div>
                            <div class="fw-semibold">@ticket.PassengerName</div>
                            @if (ticket.CheckedInAt.HasValue)
                            {
                                <small class="text-muted">Lên xe lúc: @ticket.CheckedInAt.Value.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</small>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<!-- Modal phóng to QR -->
<div class="modal fade" id="qrModal" tabindex="-1" aria-labelledby="qrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content p-3 text-center">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold" id="qrModalLabel">Mã QR — Ghế <span id="qrModalSeat"></span></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <img id="qrModalImg" src="" alt="QR Code" class="rounded-3 border" style="border-color:var(--futa-orange)!important;" />
                <p class="text-muted small mt-2 mb-0">Xuất trình cho nhân viên soát vé</p>
            </div>
        </div>
    </div>
</div>

<!-- Modal xác nhận hủy vé -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Xác nhận hủy vé</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc muốn hủy đơn vé <strong id="cancelRouteName"></strong>?</p>
                <p class="text-muted small mb-0">Sau khi hủy, toàn bộ ghế trong đơn sẽ được giải phóng và không thể khôi phục.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Không, giữ lại vé</button>
                <form id="cancelForm" method="post" action="/Payment/CancelBooking">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="cancelBookingId" name="bookingId" value="" />
                    <button type="submit" class="btn btn-danger rounded-3 fw-bold">
                        <i class="bi bi-x-circle me-1"></i>Đồng ý hủy vé
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Phóng to QR
        function openQrModal(img) {
            document.getElementById('qrModalImg').src  = img.src;
            document.getElementById('qrModalSeat').textContent = img.dataset.seat;
            new bootstrap.Modal(document.getElementById('qrModal')).show();
        }

        // Điền bookingId vào modal hủy
        document.getElementById('cancelModal').addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            document.getElementById('cancelBookingId').value = btn.dataset.bookingId;
            document.getElementById('cancelRouteName').textContent  = btn.dataset.route;
        });
    </script>
}
