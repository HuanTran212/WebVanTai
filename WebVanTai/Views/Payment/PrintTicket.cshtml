@model WebVanTai.Models.ViewModels.TicketHistoryViewModel
@using WebVanTai.Models.Enums
@{
    Layout = null;
    var activeTickets = Model.Tickets.Where(t => t.Status != TicketStatus.Void).OrderBy(t => t.SeatCode).ToList();
    var payMethodName = Model.PaymentMethod switch
    {
        PaymentMethod.Cash => "Tiền mặt tại quầy",
        _ => "VNPay"
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>In vé #@Model.BookingId - G-Trans</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background: #f1f5f9;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            color: #0f172a;
        }
        .print-toolbar {
            max-width: 780px;
            margin: 20px auto 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }
        .ticket-sheet {
            max-width: 780px;
            margin: 0 auto 24px;
            background: #ffffff;
            border: 2px solid #0f172a;
            border-radius: 14px;
            overflow: hidden;
            page-break-inside: avoid;
        }
        .ticket-sheet-header {
            background: #F26522;
            color: #ffffff;
            padding: 16px 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .ticket-divider {
            border-top: 2px dashed #cbd5e1;
            margin: 14px 0;
        }
        .seat-tag {
            background: #0f172a;
            color: #ffffff;
            padding: 4px 14px;
            border-radius: 8px;
            font-weight: 800;
            font-size: 1.05rem;
            display: inline-block;
        }
        @@media print {
            body { background: #ffffff; }
            .no-print { display: none !important; }
            .ticket-sheet {
                box-shadow: none !important;
                margin: 0 0 18px 0;
                border: 1.5px solid #000;
            }
            .ticket-sheet-header {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
    <div class="print-toolbar no-print px-3">
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Quay lại
        </a>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-dark fw-bold px-4" onclick="window.print()">
                <i class="bi bi-printer-fill me-1"></i>In vé ngay
            </button>
        </div>
    </div>

    @foreach (var ticket in activeTickets)
    {
        <div class="ticket-sheet shadow-sm">
            <div class="ticket-sheet-header">
                <div>
                    <div class="fw-bold fs-5"><i class="bi bi-bus-front-fill me-2"></i>G-TRANS EXPRESS</div>
                    <div class="small opacity-75">THẺ LÊN XE / BOARDING PASS &bull; HOTLINE 1900 6868</div>
                </div>
                <div class="text-end">
                    <div class="small opacity-75">Mã đơn / Vé</div>
                    <div class="fw-bold fs-5">#@Model.BookingId - #@ticket.TicketId</div>
                </div>
            </div>

            <div class="p-4">
                <div class="row g-3 align-items-center">
                    <div class="col-md-8">
                        <div class="mb-2 d-flex align-items-center gap-2 flex-wrap">
                            <span class="seat-tag">GHẾ @ticket.SeatCode</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">@payMethodName</span>
                            @if (!string.IsNullOrEmpty(Model.SoldByStaffName))
                            {
                                <span class="badge bg-light text-dark border">Bán tại quầy: @Model.SoldByStaffName</span>
                            }
                        </div>

                        <h4 class="fw-bold mb-1">@Model.RouteName</h4>
                        <div class="text-muted small mb-3">
                            Xe: <strong>@Model.LicensePlate</strong> &bull; @Model.BusTypeName
                        </div>

                        <div class="row g-2 small">
                            <div class="col-6">
                                <div class="text-muted">Hành khách</div>
                                <div class="fw-bold fs-6">@ticket.PassengerName</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted">Số điện thoại</div>
                                <div class="fw-bold fs-6">@ticket.PassengerPhone</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted">Giờ xuất bến</div>
                                <div class="fw-bold text-danger fs-6">@Model.DepartureTime.ToString("HH:mm dd/MM/yyyy")</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted">Giá vé</div>
                                <div class="fw-bold fs-6">@((activeTickets.Count > 0 ? Model.TotalAmount / activeTickets.Count : Model.TotalAmount).ToString("N0")) đ</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 text-center">
                        @if (!string.IsNullOrEmpty(ticket.QrToken))
                        {
                            <img src="/Payment/QrImage?token=@ticket.QrToken" alt="QR @ticket.SeatCode"
                                 style="width:150px;height:150px;border:2px solid #F26522;border-radius:10px;padding:4px;background:#fff;" />
                            <div class="small text-muted mt-1">Quét mã QR khi lên xe</div>
                        }
                    </div>
                </div>

                <div class="ticket-divider"></div>

                <div class="row g-2 small">
                    <div class="col-md-6">
                        <span class="text-muted d-block">Điểm đón khách:</span>
                        <strong>@Model.PickupStationName</strong>
                        <div class="text-muted">@Model.PickupStationAddress</div>
                    </div>
                    <div class="col-md-6">
                        <span class="text-muted d-block">Điểm trả khách:</span>
                        <strong>@Model.DropoffStationName</strong>
                        <div class="text-muted">@Model.DropoffStationAddress</div>
                    </div>
                </div>
            </div>
        </div>
    }
</body>
</html>
