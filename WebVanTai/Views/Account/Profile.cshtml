@model WebVanTai.Models.ViewModels.AccountManagePageViewModel
@{
    ViewData["Title"] = "Thông tin tài khoản";
}

<div class="container py-4" style="max-width: 960px;">
    <div class="p-4 rounded-4 text-white mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3"
         style="background: linear-gradient(135deg, #F26522, #d9531e);">
        <div>
            <h4 class="fw-bold mb-1"><i class="bi bi-person-circle me-2"></i>Hồ sơ tài khoản</h4>
            <p class="mb-0 opacity-75">Xem &amp; cập nhật thông tin cá nhân, bảo mật mật khẩu</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger rounded-3" role="alert">
            <div asp-validation-summary="All" class="mb-0 small"></div>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-person-lines-fill text-futa me-2"></i>Thông tin cá nhân</h6>
                </div>
                <form asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">Email đăng nhập</label>
                            <input class="form-control bg-light" value="@Model.Profile.Email" readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">Vai trò tài khoản</label>
                            <div>
                                @foreach (var role in Model.Profile.Roles)
                                {
                                    <span class="badge bg-warning-subtle text-dark border me-1">@role</span>
                                }
                                <span class="text-muted small ms-1">Tham gia: @Model.Profile.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Profile.FullName" class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                            <input asp-for="Profile.FullName" class="form-control" required />
                            <span asp-validation-for="Profile.FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-0">
                            <label asp-for="Profile.PhoneNumber" class="form-label fw-semibold">Số điện thoại</label>
                            <input asp-for="Profile.PhoneNumber" class="form-control" placeholder="0909123456" />
                            <span asp-validation-for="Profile.PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top p-3 px-4 text-end">
                        <button type="submit" class="btn btn-futa rounded-pill px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i>Lưu thông tin
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-shield-lock-fill text-futa me-2"></i>Đổi mật khẩu</h6>
                </div>
                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="Password.CurrentPassword" class="form-label fw-semibold">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                            <input asp-for="Password.CurrentPassword" class="form-control" autocomplete="current-password" required />
                            <span asp-validation-for="Password.CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password.NewPassword" class="form-label fw-semibold">Mật khẩu mới <span class="text-danger">*</span></label>
                            <input asp-for="Password.NewPassword" class="form-control" autocomplete="new-password" required />
                            <span asp-validation-for="Password.NewPassword" class="text-danger small"></span>
                            <small class="text-muted">Tối thiểu 6 ký tự, có chữ thường và chữ số.</small>
                        </div>

                        <div class="mb-0">
                            <label asp-for="Password.ConfirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                            <input asp-for="Password.ConfirmPassword" class="form-control" autocomplete="new-password" required />
                            <span asp-validation-for="Password.ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top p-3 px-4 text-end">
                        <button type="submit" class="btn btn-dark rounded-pill px-4 fw-semibold">
                            <i class="bi bi-key me-1"></i>Cập nhật mật khẩu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
