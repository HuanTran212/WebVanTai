@model WebVanTai.Controllers.HomeViewModel
@{
    ViewData["Title"] = "G-Trans - Hệ Thống Đặt Vé Xe Khách Cao Cấp & Trực Tuyến Toàn Quốc";
    var tomorrow = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<style>
    /* Hero Banner Modern */
    .gtrans-hero {
        background: linear-gradient(135deg, rgba(242, 101, 34, 0.94) 0%, rgba(200, 65, 12, 0.96) 60%, rgba(15, 23, 42, 0.92) 100%),
                    url('https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
        border-radius: 28px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 40px -15px rgba(242, 101, 34, 0.3);
    }

    .gtrans-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.18) 0%, transparent 50%);
        pointer-events: none;
    }

    /* Floating Booking Box */
    .booking-floating-box {
        margin-top: -65px;
        position: relative;
        z-index: 20;
    }

    @@media (max-width: 768px) {
        .booking-floating-box {
            margin-top: -35px;
        }
    }

    /* Segmented trip type selector */
    .trip-type-segmented {
        background: #F1F5F9;
        padding: 4px;
        border-radius: 9999px;
        display: inline-flex;
    }

    .trip-type-segmented input[type="radio"] {
        display: none;
    }

    .trip-type-segmented label {
        padding: 6px 18px;
        border-radius: 9999px;
        font-size: 0.85rem;
        font-weight: 700;
        color: #64748B;
        cursor: pointer;
        transition: all 0.2s ease;
        margin: 0;
    }

    .trip-type-segmented input[type="radio"]:checked + label {
        background: #FFFFFF;
        color: var(--futa-orange);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    /* Custom Form Input Container */
    .gtrans-input-wrap {
        background: #F8FAFC;
        border: 1.5px solid #E2E8F0;
        border-radius: 16px;
        padding: 10px 14px;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        height: 100%;
    }

    .gtrans-input-wrap:focus-within {
        background: #FFFFFF;
        border-color: var(--futa-orange);
        box-shadow: 0 0 0 4px rgba(242, 101, 34, 0.12);
    }

    .gtrans-input-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #94A3B8;
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 2px;
        letter-spacing: 0.03em;
    }

    .gtrans-select, .gtrans-date {
        border: none;
        outline: none;
        background: transparent;
        font-size: 0.975rem;
        font-weight: 700;
        color: #0F172A;
        width: 100%;
        padding: 0;
        cursor: pointer;
    }

    /* Popular Route Card */
    .route-card-v2 {
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid #F1F5F9;
        overflow: hidden;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.05);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .route-card-v2:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 35px -10px rgba(15, 23, 42, 0.12);
        border-color: #FDBA74;
    }

    .route-card-v2-img {
        height: 175px;
        position: relative;
        overflow: hidden;
    }

    .route-card-v2-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .route-card-v2:hover .route-card-v2-img img {
        transform: scale(1.08);
    }
</style>

<!-- 1. HERO BANNER -->
<section class="gtrans-hero p-4 sm:p-5 md:p-6 lg:p-7 text-white mb-4">
    <div class="row align-items-center">
        <div class="col-12 col-lg-8">
            <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold tracking-wider uppercase bg-white/20 backdrop-blur-md text-white border border-white/25 shadow-sm mb-3">
                <i class="bi bi-patch-check-fill text-warning"></i> G-Trans Premium Fleet 2026
            </span>
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black tracking-tight leading-tight mb-3">
                HÀNH TRÌNH ÊM ÁI, <br class="d-none d-sm-inline"/><span style="color: #FFEEDD;">TRỌN VẸN NIỀM VUI</span>
            </h1>
            <p class="lead mb-4 text-white-50" style="max-width: 620px; font-size: 1.05rem;">
                Hệ thống xe khách liên tỉnh chất lượng cao hàng đầu Việt Nam. Đặt vé trực tuyến nhanh chóng trong 60 giây, chọn chỗ 3D thông minh, thanh toán VNPay bảo mật 100%.
            </p>
            <div class="d-flex flex-wrap gap-3 gap-md-4 text-white small font-medium">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-warning"></i>
                    <span><strong>@Model.TotalTrips+</strong> Chuyến xe mỗi ngày</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-warning"></i>
                    <span><strong>@Model.TotalStations+</strong> Trạm đón trả toàn quốc</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-warning"></i>
                    <span>Giữ chỗ <strong>10 phút</strong> chống trùng vé</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 2. FLOATING BOOKING WIDGET -->
<div class="booking-floating-box mb-5">
    <div class="modern-card p-3 p-sm-4 p-lg-5 shadow-2xl">
        <!-- Trip Type Segmented Tabs -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div class="trip-type-segmented">
                <input type="radio" id="typeOneWay" name="tripType" value="oneway" checked>
                <label for="typeOneWay"><i class="bi bi-arrow-right me-1"></i> Một chiều</label>

                <input type="radio" id="typeRoundTrip" name="tripType" value="roundtrip">
                <label for="typeRoundTrip"><i class="bi bi-arrow-left-right me-1"></i> Khứ hồi</label>
            </div>

            <div class="text-muted small d-none d-md-flex align-items-center gap-1">
                <i class="bi bi-shield-check text-success"></i>
                <span>Cam kết giá niêm yết chính hãng, không phụ thu</span>
            </div>
        </div>

        <!-- Search Form -->
        <form method="get" asp-controller="Trips" asp-action="Index" id="futaSearchForm">
            <div class="row g-2 g-md-3 align-items-center">
                <!-- Điểm Đi -->
                <div class="col-12 col-md-4 col-lg-3">
                    <div class="gtrans-input-wrap">
                        <label class="gtrans-input-label" for="startProvinceSelect">
                            <i class="bi bi-geo-alt-fill text-danger fs-6"></i> Điểm khởi hành
                        </label>
                        <select class="gtrans-select" id="startProvinceSelect" name="startProvince" required>
                            <option value="">-- Chọn điểm đi --</option>
                            @foreach (var prov in Model.StartProvinces)
                            {
                                <option value="@prov" selected="@(prov.Contains("Hồ Chí Minh") ? "selected" : null)">@prov</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Nút Đổi Chiều (Desktop & Mobile) -->
                <div class="col-12 col-md-auto d-flex justify-content-center p-0">
                    <button type="button" class="swap-btn-round" id="btnSwap" title="Hoán đổi điểm đi và điểm đến" aria-label="Hoán đổi điểm đi và đến">
                        <i class="bi bi-arrow-left-right fs-5"></i>
                    </button>
                </div>

                <!-- Điểm Đến -->
                <div class="col-12 col-md-4 col-lg-3">
                    <div class="gtrans-input-wrap">
                        <label class="gtrans-input-label" for="endProvinceSelect">
                            <i class="bi bi-flag-fill text-warning fs-6"></i> Điểm đến
                        </label>
                        <select class="gtrans-select" id="endProvinceSelect" name="endProvince" required>
                            <option value="">-- Chọn điểm đến --</option>
                            @foreach (var prov in Model.EndProvinces)
                            {
                                <option value="@prov" selected="@(prov.Contains("Lâm Đồng") ? "selected" : null)">@prov</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Ngày Đi -->
                <div class="col-12 col-md-3 col-lg-2">
                    <div class="gtrans-input-wrap">
                        <label class="gtrans-input-label" for="departureDateInput">
                            <i class="bi bi-calendar3 text-primary fs-6"></i> Ngày khởi hành
                        </label>
                        <input type="date" class="gtrans-date" id="departureDateInput" name="departureDate" 
                               value="@tomorrow" min="@today" required>
                    </div>
                </div>

                <!-- Nút Tìm Chuyến Xe -->
                <div class="col-12 col-md-12 col-lg-3">
                    <button type="submit" class="btn btn-futa w-100 fw-bold d-flex align-items-center justify-content-center gap-2" 
                            style="min-height: 58px; border-radius: 16px; font-size: 1.05rem; letter-spacing: 0.5px;">
                        <i class="bi bi-search fs-5"></i>
                        <span>TÌM CHUYẾN XE</span>
                    </button>
                </div>
            </div>

            <!-- Validation Feedback -->
            <div id="searchValidationError" class="alert alert-warning py-2 small my-2 d-none rounded-3 border-warning">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> <span id="searchValidationText"></span>
            </div>

            <!-- Quick Suggestions -->
            <div class="d-flex align-items-center gap-2 mt-3 pt-2 border-top flex-wrap">
                <span class="text-muted small fw-bold">Gợi ý chặng HOT:</span>
                <a href="/Trips?startProvince=Hồ Chí Minh&endProvince=Lâm Đồng&departureDate=@tomorrow" class="quick-route-chip">
                    <i class="bi bi-pin-map-fill text-danger"></i> TP.HCM ➔ Đà Lạt
                </a>
                <a href="/Trips?startProvince=Hồ Chí Minh&endProvince=Khánh Hòa&departureDate=@tomorrow" class="quick-route-chip">
                    <i class="bi bi-pin-map-fill text-warning"></i> TP.HCM ➔ Nha Trang
                </a>
                <a href="/Trips?startProvince=Hồ Chí Minh&endProvince=Bà Rịa - Vũng Tàu&departureDate=@tomorrow" class="quick-route-chip">
                    <i class="bi bi-pin-map-fill text-success"></i> TP.HCM ➔ Vũng Tàu
                </a>
                <a href="/Trips?startProvince=Hà Nội&endProvince=Lào Cai&departureDate=@tomorrow" class="quick-route-chip">
                    <i class="bi bi-pin-map-fill text-primary"></i> Hà Nội ➔ Sapa
                </a>
            </div>
        </form>
    </div>
</div>

<!-- 3. POPULAR ROUTES SECTION -->
<section class="mb-5 pb-2">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1 font-bold">
                    <i class="bi bi-fire me-1"></i> Tuyến Phổ Biến
                </span>
            </div>
            <h2 class="h3 fw-bold text-dark mb-0">
                Các Chặng Xe <span class="text-futa">Được Yêu Thích Nhất</span>
            </h2>
        </div>
        <a asp-controller="Trips" asp-action="Index" class="btn btn-outline-secondary btn-sm fw-semibold rounded-pill px-3">
            Xem tất cả chuyến xe <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row g-4">
        @if (Model.PopularRoutes.Any())
        {
            @foreach (var route in Model.PopularRoutes)
            {
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="route-card-v2">
                        <div class="route-card-v2-img">
                            <img src="@route.ImageUrl" alt="@route.StartProvince đi @route.EndProvince" loading="lazy">
                            <div class="position-absolute top-3 start-3 bg-dark/75 backdrop-blur-md text-white text-xs px-2.5 py-1 rounded-pill fw-semibold">
                                <i class="bi bi-clock me-1 text-warning"></i> ~@route.DurationHours.ToString("0.#")h (@route.DistanceKm km)
                            </div>
                            <div class="position-absolute bottom-3 end-3 bg-futa text-white text-sm px-3 py-1 rounded-pill fw-bold shadow">
                                Từ @route.MinPrice.ToString("N0") đ
                            </div>
                        </div>
                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <h3 class="h5 fw-bold text-dark mb-1 d-flex align-items-center justify-content-between">
                                <span>@route.StartProvince</span>
                                <i class="bi bi-arrow-right text-warning fs-5"></i>
                                <span>@route.EndProvince</span>
                            </h3>
                            <p class="text-muted small mb-3 flex-grow-1">
                                <i class="bi bi-bus-front text-secondary me-1"></i> @route.BusTypeSummary
                            </p>
                            <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                <span class="badge bg-light text-muted border">
                                    <i class="bi bi-calendar-check text-success me-1"></i> Chạy hàng ngày
                                </span>
                                <a href="/Trips?startProvince=@Uri.EscapeDataString(route.StartProvince)&endProvince=@Uri.EscapeDataString(route.EndProvince)&departureDate=@tomorrow" 
                                   class="btn btn-futa btn-sm fw-bold px-3 rounded-pill">
                                    Chọn vé <i class="bi bi-chevron-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-4">
                <div class="alert alert-light border rounded-4 p-4">
                    <i class="bi bi-info-circle text-primary fs-3 d-block mb-2"></i>
                    <p class="mb-0 text-muted">Chưa có tuyến xe nào được thiết lập trong hệ thống.</p>
                </div>
            </div>
        }
    </div>
</section>

<!-- 4. WHY CHOOSE G-TRANS (VALUE PROPOSITIONS) -->
<section class="mb-5 py-5 px-3 px-md-4 rounded-4" style="background: #FFFFFF; border: 1px solid #F1F5F9; box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);">
    <div class="text-center mb-5">
        <span class="badge bg-warning-subtle text-dark rounded-pill px-3 py-1 font-bold mb-2">Cam Kết Chất Lượng</span>
        <h2 class="h3 fw-bold text-dark mb-2">
            Tại Sao Bạn Nên Chọn <span class="text-futa">G-Trans</span>?
        </h2>
        <p class="text-muted mx-auto" style="max-width: 620px;">
            Chúng tôi kiến tạo trải nghiệm di chuyển xe khách chuẩn mực cao, an toàn tuyệt đối và thuận tiện nhất cho mọi hành khách.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="p-4 rounded-4 border bg-slate-50/50 text-center h-100 transition-all hover:shadow-md">
                <div class="w-14 h-14 rounded-2xl bg-orange-100 text-futa mx-auto d-flex align-items-center justify-content-center fs-2 mb-3 shadow-sm">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h3 class="h6 fw-bold mb-2 text-dark">An Toàn & Đúng Giờ</h3>
                <p class="text-muted small mb-0">Cam kết 100% xuất bến đúng giờ, xe bảo dưỡng định kỳ và tài xế được đào tạo chuyên nghiệp.</p>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="p-4 rounded-4 border bg-slate-50/50 text-center h-100 transition-all hover:shadow-md">
                <div class="w-14 h-14 rounded-2xl bg-blue-100 text-primary mx-auto d-flex align-items-center justify-content-center fs-2 mb-3 shadow-sm">
                    <i class="bi bi-wifi"></i>
                </div>
                <h3 class="h6 fw-bold mb-2 text-dark">Đội Xe Limousine 2026</h3>
                <p class="text-muted small mb-0">Dàn xe Limousine phòng riêng VIP và Giường nằm cao cấp, wifi tốc độ cao, sạc USB, rèm riêng tư.</p>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="p-4 rounded-4 border bg-slate-50/50 text-center h-100 transition-all hover:shadow-md">
                <div class="w-14 h-14 rounded-2xl bg-emerald-100 text-success mx-auto d-flex align-items-center justify-content-center fs-2 mb-3 shadow-sm">
                    <i class="bi bi-qr-code-scan"></i>
                </div>
                <h3 class="h6 fw-bold mb-2 text-dark">Vé Điện Tử QR 1 Chạm</h3>
                <p class="text-muted small mb-0">Không cần in vé giấy. Check-in lên xe siêu tốc 1 chạm bằng camera quét mã QR tức thì tại bến.</p>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="p-4 rounded-4 border bg-slate-50/50 text-center h-100 transition-all hover:shadow-md">
                <div class="w-14 h-14 rounded-2xl bg-purple-100 text-purple-600 mx-auto d-flex align-items-center justify-content-center fs-2 mb-3 shadow-sm">
                    <i class="bi bi-credit-card-2-front"></i>
                </div>
                <h3 class="h6 fw-bold mb-2 text-dark">Thanh Toán An Toàn</h3>
                <p class="text-muted small mb-0">Tích hợp cổng VNPay bảo mật chuẩn ngân hàng, giữ chỗ tự động 10 phút chống trùng vé.</p>
            </div>
        </div>
    </div>
</section>

<!-- 5. 4-STEP BOOKING GUIDE -->
<section class="mb-5 pb-3">
    <div class="text-center mb-4">
        <h2 class="h4 fw-bold text-dark mb-1">Quy Trình Đặt Vé Đơn Giản</h2>
        <p class="text-muted small">Chỉ với 4 bước đơn giản để sở hữu vé xe khách G-Trans</p>
    </div>

    <div class="row g-3 g-md-4 text-center">
        <div class="col-6 col-md-3">
            <div class="p-3 p-md-4 bg-white rounded-4 shadow-sm border h-100">
                <div class="w-10 h-10 rounded-full bg-futa text-white font-black fs-5 mx-auto d-flex align-items-center justify-content-center mb-2 shadow">1</div>
                <h3 class="h6 fw-bold mb-1 text-dark">Tìm Chuyến Xe</h3>
                <p class="text-muted small mb-0">Chọn nơi đi, nơi đến và ngày khởi hành mong muốn.</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 p-md-4 bg-white rounded-4 shadow-sm border h-100">
                <div class="w-10 h-10 rounded-full bg-futa text-white font-black fs-5 mx-auto d-flex align-items-center justify-content-center mb-2 shadow">2</div>
                <h3 class="h6 fw-bold mb-1 text-dark">Chọn Chỗ & Trạm</h3>
                <p class="text-muted small mb-0">Chọn sơ đồ ghế trực quan và trạm đón/trả thuận tiện.</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 p-md-4 bg-white rounded-4 shadow-sm border h-100">
                <div class="w-10 h-10 rounded-full bg-futa text-white font-black fs-5 mx-auto d-flex align-items-center justify-content-center mb-2 shadow">3</div>
                <h3 class="h6 fw-bold mb-1 text-dark">Thanh Toán An Toàn</h3>
                <p class="text-muted small mb-0">Thanh toán qua cổng VNPay với mã bảo mật chuẩn.</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 p-md-4 bg-white rounded-4 shadow-sm border h-100">
                <div class="w-10 h-10 rounded-full bg-futa text-white font-black fs-5 mx-auto d-flex align-items-center justify-content-center mb-2 shadow">4</div>
                <h3 class="h6 fw-bold mb-1 text-dark">Lên Xe Trải Nghiệm</h3>
                <p class="text-muted small mb-0">Xuất trình mã QR trên điện thoại cho nhân viên soát vé.</p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const btnSwap = document.getElementById('btnSwap');
        const startSelect = document.getElementById('startProvinceSelect');
        const endSelect = document.getElementById('endProvinceSelect');
        const departureDateInput = document.getElementById('departureDateInput');
        const searchForm = document.getElementById('futaSearchForm');
        const valErrorBox = document.getElementById('searchValidationError');
        const valErrorText = document.getElementById('searchValidationText');

        // 1. Cập nhật ngày min theo giờ cục bộ của trình duyệt
        if (departureDateInput) {
            const todayLocal = new Date().toLocaleDateString('en-CA');
            departureDateInput.min = todayLocal;
            if (departureDateInput.value && departureDateInput.value < todayLocal) {
                departureDateInput.value = todayLocal;
            }
        }

        // Helper: Gán giá trị cho select, nếu option chưa có thì bổ sung tạm thời
        function assignSelectValue(selectElem, targetVal) {
            if (!targetVal) return;
            let exists = false;
            for (let i = 0; i < selectElem.options.length; i++) {
                if (selectElem.options[i].value === targetVal) {
                    selectElem.selectedIndex = i;
                    exists = true;
                    break;
                }
            }
            if (!exists) {
                const newOpt = new Option(targetVal, targetVal, true, true);
                selectElem.add(newOpt);
            }
        }

        // 2. Hoán đổi Điểm đi và Điểm đến mượt mà
        if (btnSwap && startSelect && endSelect) {
            btnSwap.addEventListener('click', function () {
                const oldStart = startSelect.value;
                const oldEnd = endSelect.value;

                if (!oldStart && !oldEnd) return;

                assignSelectValue(startSelect, oldEnd);
                assignSelectValue(endSelect, oldStart);

                if (valErrorBox) valErrorBox.classList.add('d-none');

                btnSwap.style.transform = 'rotate(180deg) scale(1.15)';
                setTimeout(() => {
                    btnSwap.style.transform = '';
                }, 300);
            });
        }

        // Tự động ẩn lỗi khi thay đổi lựa chọn
        [startSelect, endSelect].forEach(elem => {
            if (elem) {
                elem.addEventListener('change', function () {
                    if (valErrorBox) valErrorBox.classList.add('d-none');
                });
            }
        });

        // 3. Validate form khi submit không dùng alert
        if (searchForm) {
            searchForm.addEventListener('submit', function (e) {
                if (startSelect.value && endSelect.value && startSelect.value === endSelect.value) {
                    e.preventDefault();
                    if (valErrorBox && valErrorText) {
                        valErrorText.textContent = 'Điểm đi và điểm đến không thể trùng nhau. Vui lòng chọn điểm đến khác.';
                        valErrorBox.classList.remove('d-none');
                        endSelect.focus();
                    } else {
                        endSelect.focus();
                    }
                }
            });
        }
    });
</script>
}
