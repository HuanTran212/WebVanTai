<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebVanTai</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebVanTai.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 sticky-top">
            <div class="container">
                <a class="navbar-brand fw-bold text-danger" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-bus-front-fill me-1"></i> WebVanTai
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger fw-semibold" asp-area="" asp-controller="Booking" asp-action="Index">
                                <i class="bi bi-ticket-perforated"></i> Đặt vé ngay
                            </a>
                        </li>
                    </ul>

                    <!-- Góc Đăng Nhập & Quản Trị Hệ Thống -->
                    <ul class="navbar-nav align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-semibold d-flex align-items-center gap-1" href="#" id="userNavDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle text-primary fs-5"></i>
                                    <span>@(User.Identity.Name ?? "Tài khoản")</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userNavDropdown">
                                    @if (User.IsInRole("RouteManager") || User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 text-warning fw-semibold" asp-area="RouteManager" asp-controller="Dashboard" asp-action="Index">
                                                <i class="bi bi-speedometer2 me-2"></i>Bảng Điều Hành Tuyến Xe
                                            </a>
                                        </li>
                                    }
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 text-danger fw-semibold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                                <i class="bi bi-shield-lock me-2"></i>Quản Trị Hệ Thống (Admin)
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-area="RouteManager" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item text-secondary">
                                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="btn btn-outline-warning text-dark btn-sm fw-semibold dropdown-toggle" href="#" id="loginDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock me-1"></i> Quản Trị & Đăng Nhập
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="loginDropdown" style="min-width: 250px;">
                                    <li><h6 class="dropdown-header text-uppercase small">Khu vực điều hành</h6></li>
                                    <li>
                                        <a class="dropdown-item py-2 fw-semibold text-warning" asp-area="RouteManager" asp-controller="Dashboard" asp-action="Index">
                                            <i class="bi bi-bus-front me-2"></i>Bảng Điều Hành Tuyến
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2 text-primary" href="/Identity/Account/Login">
                                            <i class="bi bi-box-arrow-in-right me-2"></i>Màn hình Đăng Nhập
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 text-dark small" href="/RouteManager/Account/QuickLogin?role=RouteManager">
                                            <i class="bi bi-lightning-charge-fill text-warning me-2"></i>Vào nhanh: <strong>RouteManager</strong>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 text-dark small" href="/RouteManager/Account/QuickLogin?role=Admin">
                                            <i class="bi bi-lightning-charge-fill text-danger me-2"></i>Vào nhanh: <strong>Admin</strong>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-md-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-4">
        <div class="container text-center">
            &copy; 2026 - WebVanTai - Hệ thống đặt vé xe khách trực tuyến chuẩn 3NF
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
