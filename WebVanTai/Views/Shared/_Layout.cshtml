<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"]?.ToString()?.Contains("G-Trans") == true ? ViewData["Title"] : $"{ViewData["Title"]} - G-Trans")</title>
    <meta name="description" content="G-Trans - Hệ thống đặt vé xe khách liên tỉnh trực tuyến, chọn ghế thông minh, thanh toán an toàn, nhận vé QR tức thì." />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebVanTai.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-polish.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            corePlugins: { preflight: false },
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#fff7ed',
                            100: '#ffedd5',
                            200: '#fed7aa',
                            300: '#fdba74',
                            400: '#fb923c',
                            500: '#f97316',
                            600: '#ea580c',
                            700: '#c2410c',
                            800: '#9a3412',
                            900: '#7c2d12',
                        },
                        futa: { DEFAULT: '#F26522', dark: '#D95413', light: '#FFF5EE', subtle: '#FFEEDD' },
                        night: { DEFAULT: '#0F172A', light: '#1E293B', dark: '#020617' }
                    },
                    fontFamily: {
                        sans: ['system-ui', '-apple-system', 'Segoe UI', 'Roboto', 'Helvetica', 'Arial', 'sans-serif']
                    }
                }
            }
        };
    </script>
    <style>
        :root {
            --futa-orange: #F26522;
            --futa-orange-hover: #D95413;
        }
        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #F8FAFC;
            color: #334155;
        }
        .text-futa { color: var(--futa-orange) !important; }
        .bg-futa { background-color: var(--futa-orange) !important; }
        .btn-futa {
            background-color: var(--futa-orange);
            color: #fff;
            border: none;
        }
        .btn-futa:hover {
            background-color: var(--futa-orange-hover);
            color: #fff;
        }
        .btn-outline-futa {
            border-color: var(--futa-orange);
            color: var(--futa-orange);
        }
        .btn-outline-futa:hover {
            background-color: var(--futa-orange);
            color: #fff;
        }
        .nav-link.active {
            color: var(--futa-orange) !important;
            font-weight: 700;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white/95 backdrop-blur-md border-bottom shadow-sm mb-3 sticky-top" style="border-top: 3px solid #F26522;">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none py-1" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="brand-logo-icon">
                        <i class="bi bi-bus-front-fill"></i>
                    </div>
                    <div class="d-flex flex-column leading-none">
                        <span class="brand-text">G-Trans</span>
                        <span class="brand-subtext d-none d-sm-block">EXPRESS & LIMOUSINE</span>
                    </div>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbarCollapse" aria-controls="mainNavbarCollapse"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-lg-flex justify-content-between" id="mainNavbarCollapse">
                    <ul class="navbar-nav flex-grow-1 align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold px-3 py-2 rounded-lg" asp-area="" asp-controller="Home" asp-action="Index">
                                Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold px-3 py-2 rounded-lg" asp-area="" asp-controller="Trips" asp-action="Index">
                                Tra cứu lịch trình
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold px-3 py-2 rounded-lg" asp-area="" asp-controller="Home" asp-action="Contact">
                                Liên hệ
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-semibold px-3 py-2 rounded-lg" asp-area="" asp-controller="Payment" asp-action="MyTickets">
                                    Vé của tôi
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Góc Đăng Nhập / Tài Khoản Khách Hàng -->
                    <ul class="navbar-nav align-items-lg-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-semibold d-flex align-items-center gap-1" href="#" id="userNavDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span>@(User.Identity.Name ?? "Tài khoản")</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userNavDropdown">
                                    <li>
                                        <a class="dropdown-item py-2 fw-semibold" asp-area="" asp-controller="Payment" asp-action="MyTickets">
                                            <i class="bi bi-ticket-perforated me-2 text-futa"></i>Vé của tôi
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 fw-semibold" asp-area="" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-gear me-2 text-futa"></i>Thông tin tài khoản
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Admin") || User.IsInRole("RouteManager") || User.IsInRole("TicketInspector") || User.IsInRole("TicketManager"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <li>
                                                <a class="dropdown-item py-2 text-danger fw-semibold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                                    Quản trị hệ thống (Admin)
                                                </a>
                                            </li>
                                        }
                                        @if (User.IsInRole("TicketManager") || User.IsInRole("Admin"))
                                        {
                                            <li>
                                                <a class="dropdown-item py-2 text-success fw-semibold" asp-area="TicketManager" asp-controller="Dashboard" asp-action="Index">
                                                    Quản lý vé
                                                </a>
                                            </li>
                                        }
                                        @if (User.IsInRole("RouteManager") || User.IsInRole("Admin"))
                                        {
                                            <li>
                                                <a class="dropdown-item py-2 text-warning fw-semibold" asp-area="RouteManager" asp-controller="Dashboard" asp-action="Index">
                                                    Bảng điều hành tuyến xe
                                                </a>
                                            </li>
                                        }
                                        @if (User.IsInRole("TicketInspector") || User.IsInRole("Admin"))
                                        {
                                            <li>
                                                <a class="dropdown-item py-2 text-primary fw-semibold" asp-area="TicketInspector" asp-controller="Dashboard" asp-action="Index">
                                                    Soát vé trực tuyến
                                                </a>
                                            </li>
                                        }
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-area="Identity" asp-page="/Account/Logout"
                                              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                                              method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item text-secondary">
                                                Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-futa btn-sm fw-bold px-3 py-1.5 rounded-pill" href="/Identity/Account/Login">
                                    Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-secondary btn-sm fw-semibold px-3 py-1.5 rounded-pill" href="/Identity/Account/Register">
                                    Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="app-container">
        <main role="main" class="pb-4 pb-lg-5">
            @RenderBody()
        </main>
    </div>

    <footer class="gtrans-footer mt-5 pt-5 pb-3">
        <div class="app-container">
            <div class="row g-4 g-lg-5">
                <!-- Cột 1: Thương hiệu & Liên hệ -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="brand-logo-icon">
                            <i class="bi bi-bus-front-fill"></i>
                        </div>
                        <div class="d-flex flex-column leading-none">
                            <span class="fs-4 fw-bold text-white tracking-tight">G-Trans</span>
                            <span class="brand-subtext text-warning">EXPRESS & LIMOUSINE</span>
                        </div>
                    </div>
                    <p class="small text-slate-400 mb-3" style="line-height: 1.6;">
                        Hệ thống vận tải hành khách chất lượng cao hàng đầu Việt Nam. Kết nối mọi miền đất nước bằng dịch vụ an toàn, tiện nghi, đúng giờ với trải nghiệm đặt vé trực tuyến 4.0.
                    </p>
                    <div class="d-flex flex-column gap-2 small">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-telephone-inbound-fill text-futa"></i>
                            <span>Tổng đài 24/7: <strong class="text-white">1900 6868</strong> (1.000đ/phút)</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-envelope-check-fill text-futa"></i>
                            <span>Email: <strong class="text-white">hotro@gtrans.vn</strong></span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-geo-alt-fill text-futa"></i>
                            <span>Trụ sở chính: Tòa nhà G-Trans, TP. Hồ Chí Minh</span>
                        </div>
                    </div>
                </div>

                <!-- Cột 2: Tuyến đường trọng điểm -->
                <div class="col-6 col-md-3 col-lg-2">
                    <div class="footer-title">Tuyến Trọng Điểm</div>
                    <ul class="list-unstyled d-flex flex-column gap-2 small mb-0">
                        <li><a href="/Trips/Index?startProvince=TP.HCM&endProvince=Lâm+Đồng"><i class="bi bi-chevron-right me-1 text-futa"></i> Sài Gòn - Đà Lạt</a></li>
                        <li><a href="/Trips/Index?startProvince=TP.HCM&endProvince=Khánh+Hòa"><i class="bi bi-chevron-right me-1 text-futa"></i> Sài Gòn - Nha Trang</a></li>
                        <li><a href="/Trips/Index?startProvince=TP.HCM&endProvince=Bà+Rịa+-+Vũng+Tàu"><i class="bi bi-chevron-right me-1 text-futa"></i> Sài Gòn - Vũng Tàu</a></li>
                        <li><a href="/Trips/Index?startProvince=TP.HCM&endProvince=Cần+Thơ"><i class="bi bi-chevron-right me-1 text-futa"></i> Sài Gòn - Cần Thơ</a></li>
                        <li><a href="/Trips/Index?startProvince=Hà+Nội&endProvince=Lào+Cai"><i class="bi bi-chevron-right me-1 text-futa"></i> Hà Nội - Sapa</a></li>
                        <li><a href="/Trips/Index"><i class="bi bi-chevron-right me-1 text-futa"></i> Xem tất cả tuyến</a></li>
                    </ul>
                </div>

                <!-- Cột 3: Hướng dẫn & Dịch vụ -->
                <div class="col-6 col-md-3 col-lg-3">
                    <div class="footer-title">Hỗ Trợ & Quy Định</div>
                    <ul class="list-unstyled d-flex flex-column gap-2 small mb-0">
                        <li><a href="/Payment/MyTickets"><i class="bi bi-qr-code me-2 text-futa"></i> Tra cứu vé QR</a></li>
                        <li><a href="/Trips/Index"><i class="bi bi-search me-2 text-futa"></i> Tra cứu lịch trình xe</a></li>
                        <li><a href="/Booking/Index"><i class="bi bi-ticket-perforated me-2 text-futa"></i> Hướng dẫn đặt vé</a></li>
                        <li><a href="/Home/Contact"><i class="bi bi-envelope-paper me-2 text-futa"></i> Liên hệ hỗ trợ</a></li>
                        <li><a href="javascript:void(0)" title="Quy chế hủy vé trước 4 tiếng"><i class="bi bi-shield-check me-2 text-futa"></i> Chính sách đổi & hoàn vé</a></li>
                        <li><a href="javascript:void(0)" title="Cổng VNPay bảo mật"><i class="bi bi-credit-card me-2 text-futa"></i> Thanh toán an toàn VNPay</a></li>
                    </ul>
                </div>

                <!-- Cột 4: Hệ thống & Đăng nhập -->
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="footer-title">Hệ Thống Quản Trị</div>
                    <ul class="list-unstyled d-flex flex-column gap-2 small mb-3">
                        <li><a href="/Identity/Account/Login"><i class="bi bi-box-arrow-in-right me-2 text-futa"></i> Đăng nhập tài khoản</a></li>
                        <li><a href="/Identity/Account/Register"><i class="bi bi-person-plus me-2 text-futa"></i> Đăng ký thành viên</a></li>
                        <li><a href="/Admin/Dashboard"><i class="bi bi-shield-lock-fill text-danger me-2"></i> Bảng quản trị (Admin)</a></li>
                        <li><a href="/TicketManager/Dashboard"><i class="bi bi-ticket-perforated-fill text-success me-2"></i> Quản lý vé (Bán vé tại quầy)</a></li>
                        <li><a href="/RouteManager/Dashboard"><i class="bi bi-speedometer2 text-warning me-2"></i> Điều hành tuyến xe</a></li>
                        <li><a href="/TicketInspector/Dashboard"><i class="bi bi-qr-code-scan text-info me-2"></i> Soát vé trực tuyến</a></li>
                    </ul>
                    <div class="p-2 rounded-lg bg-slate-800/80 border border-slate-700/60 d-flex align-items-center gap-2">
                        <i class="bi bi-shield-shaded text-success fs-4"></i>
                        <div class="small">
                            <span class="text-white fw-bold d-block">Chứng nhận an toàn</span>
                            <span class="text-slate-400" style="font-size: 0.72rem;">Bảo mật thanh toán quốc tế SSL 256-bit</span>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-4 border-slate-800">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 text-slate-500 small text-center text-md-start">
                <div>
                    &copy; 2026 <strong>G-Trans</strong>. Bản quyền thuộc về Công ty Cổ phần Vận tải Hành khách G-Trans. Tất cả các quyền được bảo lưu.
                </div>
                <div class="d-flex gap-3">
                    <a href="javascript:void(0)" class="text-slate-400">Điều khoản sử dụng</a>
                    <span>•</span>
                    <a href="javascript:void(0)" class="text-slate-400">Chính sách bảo mật</a>
                    <span>•</span>
                    <a href="javascript:void(0)" class="text-slate-400">G-Trans Hotline</a>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
