@model WebVanTai.Models.ViewModels.TripBookingViewModel
@{
    ViewData["Title"] = $"Chọn ghế - {Model.StartProvince} đi {Model.EndProvince} | G-Trans";
}

<style>
    :root {
        --futa-orange: #F26522;
        --futa-dark-orange: #d9531e;
        --futa-light-orange: #fff2eb;
        --seat-available-border: #F26522;
        --seat-selected-bg: #F26522;
        --seat-occupied-bg: #e2e8f0;
        --seat-occupied-color: #94a3b8;
    }

    /* Seat Grid Modern */
    .bus-container {
        background: #F8FAFC;
        border: 2px dashed #CBD5E1;
        border-radius: 24px;
        padding: 20px 14px;
        margin: 0 auto;
        max-width: 340px;
    }

    .seat-grid {
        display: grid;
        justify-content: center;
        margin: 0 auto;
    }

    .seat-btn {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        user-select: none;
        position: relative;
        border: 2px solid transparent;
        flex-shrink: 0;
    }

    .seat-btn.available {
        background: #ffffff;
        border-color: var(--seat-available-border);
        color: var(--seat-available-border);
        box-shadow: 0 2px 6px rgba(242, 101, 34, 0.15);
    }

    .seat-btn.available:hover {
        background: #FFF5EE;
        transform: scale(1.1);
        box-shadow: 0 4px 12px rgba(242, 101, 34, 0.25);
    }

    .seat-btn.selected {
        background: var(--seat-selected-bg);
        border-color: var(--seat-selected-bg);
        color: #ffffff;
        box-shadow: 0 4px 14px rgba(242, 101, 34, 0.4);
    }

    .seat-btn.selected::after {
        content: "";
        position: absolute;
        inset: -2px;
        border-radius: 12px;
        border: 2px solid var(--futa-orange);
        animation: pulse-ring 1.5s ease-out infinite;
    }

    @@keyframes pulse-ring {
        0% { transform: scale(1); opacity: 0.6; }
        100% { transform: scale(1.3); opacity: 0; }
    }

    .seat-btn.occupied {
        background: var(--seat-occupied-bg);
        border: 2px solid #cbd5e1;
        color: var(--seat-occupied-color);
        cursor: not-allowed;
        opacity: 0.8;
    }

    .seat-btn.occupied small {
        font-size: 0.55rem;
    }

    /* Deck Switcher Segmented */
    .deck-switcher {
        display: inline-flex;
        background: #F1F5F9;
        padding: 4px;
        border-radius: 9999px;
        gap: 2px;
    }

    .deck-switcher input[type="radio"] {
        display: none;
    }

    .deck-switcher label {
        padding: 8px 20px;
        border-radius: 9999px;
        font-size: 0.875rem;
        font-weight: 700;
        color: #64748B;
        cursor: pointer;
        transition: all 0.2s ease;
        margin: 0;
    }

    .deck-switcher input[type="radio"]:checked + label {
        background: #FFFFFF;
        color: var(--futa-orange);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    /* Bus Driver Area */
    .bus-driver-area {
        background: linear-gradient(135deg, #F8FAFC 0%, #F1F5F9 100%);
        border: 2px dashed #CBD5E1;
        border-radius: 16px;
        padding: 14px;
        text-align: center;
        font-size: 0.85rem;
        font-weight: 700;
        color: #475569;
        margin-bottom: 20px;
        position: relative;
    }

    .bus-driver-area::before {
        content: "";
        position: absolute;
        top: -8px;
        left: 50%;
        transform: translateX(-50%);
        width: 60px;
        height: 8px;
        background: #E2E8F0;
        border-radius: 4px 4px 0 0;
    }

    /* Legend Modern */
    .seat-legend-v2 {
        display: flex;
        justify-content: center;
        gap: 24px;
        flex-wrap: wrap;
        padding: 16px 20px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
        border: 1px solid #F1F5F9;
        margin-bottom: 24px;
    }

    .legend-item-v2 {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.875rem;
        font-weight: 600;
        color: #334155;
    }

    .legend-box-v2 {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: 800;
    }

    /* Floating Mobile Sticky Bar */
    .floating-bar-v2 {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: #ffffff;
        box-shadow: 0 -8px 30px rgba(15, 23, 42, 0.12);
        padding: 14px 20px;
        padding-bottom: calc(14px + env(safe-area-inset-bottom));
        z-index: 1040;
        border-top: 1px solid #F1F5F9;
    }

    .price-text-v2 {
        color: var(--futa-orange);
        font-weight: 800;
        font-size: 1.35rem;
    }

    /* Form Modern */
    .form-control-modern {
        width: 100%;
        max-width: 100%;
        display: block;
        box-sizing: border-box;
        background: #F8FAFC;
        border: 1.5px solid #E2E8F0;
        border-radius: 14px;
        padding: 12px 16px;
        font-size: 0.95rem;
        font-weight: 600;
        color: #0F172A;
        transition: all 0.2s ease;
    }

    .form-control-modern:focus {
        background: #FFFFFF;
        border-color: var(--futa-orange);
        box-shadow: 0 0 0 4px rgba(242, 101, 34, 0.12);
        outline: none;
    }

    .form-select-modern {
        width: 100%;
        max-width: 100%;
        display: block;
        box-sizing: border-box;
        background-color: #F8FAFC;
        border: 1.5px solid #E2E8F0;
        border-radius: 14px;
        padding: 12px 38px 12px 16px;
        font-size: 0.95rem;
        font-weight: 600;
        color: #0F172A;
        transition: all 0.2s ease;
        text-overflow: ellipsis;
        white-space: nowrap;
        overflow: hidden;
        cursor: pointer;
    }

    .form-select-modern:focus {
        background-color: #FFFFFF;
        border-color: var(--futa-orange);
        box-shadow: 0 0 0 4px rgba(242, 101, 34, 0.12);
        outline: none;
    }

    .form-label-modern {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #94A3B8;
        letter-spacing: 0.03em;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* Desktop Sticky Card */
    .sticky-checkout-card {
        position: sticky;
        top: 95px;
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid #F1F5F9;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        padding: 24px;
    }

    /* Modern Card Container */
    .gtrans-card {
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid #F1F5F9;
        box-shadow: 0 6px 20px rgba(15, 23, 42, 0.04);
    }
</style>

<div class="app-container pb-5 pt-3">
    <!-- MODERN HEADER -->
    <div class="mb-4 p-4 p-md-5 rounded-4 position-relative overflow-hidden" style="background: linear-gradient(135deg, var(--futa-orange) 0%, #EA580C 60%, #C2410C 100%);">
        <div class="absolute inset-0 bg-gradient-to-br from-transparent via-white/5 to-transparent"></div>
        <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-3 position-relative">
            <div>
                <span class="badge bg-white/20 backdrop-blur-md text-white fw-bold px-3 py-1.5 rounded-pill mb-2 d-inline-block" style="font-size: 0.75rem;">
                    <i class="bi bi-bus-front-fill me-1"></i> @Model.BusTypeName
                </span>
                <h2 class="fw-bold text-white mb-0" style="font-size: 1.75rem;">
                    @Model.StartProvince <i class="bi bi-arrow-right text-warning mx-2"></i> @Model.EndProvince
                </h2>
                <small class="d-block mt-1 text-white-50">Biển số xe: <strong class="text-white">@Model.LicensePlate</strong></small>
            </div>
            <div class="text-end">
                <div class="text-white-50 small">Giá vé / ghế</div>
                <div class="fw-bold text-white fs-4">@Model.BasePrice.ToString("N0") đ</div>
            </div>
        </div>
        <hr class="my-3 border-white opacity-25" />
        <div class="row g-2 align-items-center position-relative">
            <div class="col-6 col-md-3">
                <small class="text-white-50 d-block">Khởi hành</small>
                <strong class="text-white">@Model.DepartureTime.ToString("HH:mm")</strong>
            </div>
            <div class="col-6 col-md-3">
                <small class="text-white-50 d-block">Ngày</small>
                <strong class="text-white">@Model.DepartureTime.ToString("dd/MM/yyyy")</strong>
            </div>
            <div class="col-12 col-md-3">
                <small class="text-white-50 d-block">Đến dự kiến</small>
                <strong class="text-white">@Model.ArrivalTime.ToString("HH:mm")</strong>
            </div>
            <div class="col-6 col-md-3 text-md-end">
                <small class="text-white-50 d-block">Thời gian chạy</small>
                <strong class="text-white">~@((Model.ArrivalTime - Model.DepartureTime).TotalHours.ToString("0.#")) giờ</strong>
            </div>
        </div>
    </div>

    <!-- VALIDATION ALERTS -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert" style="background: #FFFDF5; border-color: #FED7AA;">
            <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert" style="background: #FFF1F2; border-color: #FECACA;">
            <h6 class="fw-bold mb-2"><i class="bi bi-exclamation-triangle-fill me-1"></i> Có lỗi xảy ra:</h6>
            <div asp-validation-summary="All" class="text-danger mb-0 small"></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- SEAT LEGEND -->
    <div class="seat-legend-v2">
        <div class="legend-item-v2">
            <div class="legend-box-v2" style="background: #FFFFFF; border: 2px solid var(--seat-available-border); color: var(--seat-available-border);">
            </div>
            <span>Ghế trống</span>
        </div>
        <div class="legend-item-v2">
            <div class="legend-box-v2" style="background: var(--seat-selected-bg); color: #FFFFFF;">
                <i class="bi bi-check"></i>
            </div>
            <span>Đang chọn (tối đa 5)</span>
        </div>
        <div class="legend-item-v2">
            <div class="legend-box-v2" style="background: var(--seat-occupied-bg); border: 2px solid #cbd5e1;">
                <i class="bi bi-lock-fill" style="color: var(--seat-occupied-color);"></i>
            </div>
            <span>Đã đặt / Giữ chỗ</span>
        </div>
    </div>

    <form asp-action="BookSeats" method="post" id="bookingForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="TripId" />
        <input type="hidden" asp-for="SelectedSeats" id="selectedSeatsInput" />

        <div class="row g-4">
            <!-- LEFT COLUMN: SEAT MAP -->
            <div class="col-12 col-lg-7">
                <div class="gtrans-card">
                    <div class="p-4 border-bottom">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                <i class="bi bi-grid-3x3-gap-fill text-futa"></i> Sơ đồ ghế ngồi
                            </h5>
                            <span class="badge bg-light text-futa border fw-semibold px-3 py-1.5 rounded-pill" id="seatCountBadge" style="font-size: 0.8rem;">
                                Đã chọn: 0/5
                            </span>
                        </div>
                    </div>
                    <div class="p-3 p-md-4">
                        @if (Model.Decks.Count > 1)
                        {
                            <!-- Tab điều hướng 2 tầng trên thiết bị di động -->
                            <ul class="nav nav-pills nav-fill mb-3 d-md-none" id="deckTabs" role="tablist">
                                @for (int i = 0; i < Model.Decks.Count; i++)
                                {
                                    var deck = Model.Decks[i];
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link @(i == 0 ? "active" : "") fw-bold py-2 rounded-pill" 
                                                id="tab-deck-@deck.DeckNumber" 
                                                data-bs-toggle="pill" 
                                                data-bs-target="#deck-content-@deck.DeckNumber" 
                                                type="button" 
                                                role="tab">
                                            @deck.DeckName
                                        </button>
                                    </li>
                                }
                            </ul>
                        }

                        <div class="tab-content row g-4 justify-content-center" id="deckTabsContent">
                            @for (int i = 0; i < Model.Decks.Count; i++)
                            {
                                var deck = Model.Decks[i];
                                <div class="col-12 @(Model.Decks.Count > 1 ? "col-md-6" : "") tab-pane fade @(i == 0 ? "show active" : "") d-md-block" 
                                     id="deck-content-@deck.DeckNumber" 
                                     role="tabpanel" 
                                     aria-labelledby="tab-deck-@deck.DeckNumber">
                                    <div class="bus-container">
                                        <div class="bus-driver-area">
                                            <i class="bi bi-steering-wheel me-1"></i> Vị trí Bác Tài (@deck.DeckName)
                                        </div>
                                        <div class="seat-grid" style="display: grid; grid-template-columns: repeat(@(deck.Cols > 0 ? deck.Cols : 3), 48px); gap: 10px; justify-content: center; width: fit-content; margin: 0 auto;">
                                            @foreach (var seat in deck.Seats)
                                            {
                                                var isOccupiedClass = seat.IsOccupied ? "occupied" : "available";
                                                <div class="seat-btn @isOccupiedClass" 
                                                     data-seat-code="@seat.Code" 
                                                     data-occupied="@(seat.IsOccupied ? "true" : "false")"
                                                     role="button"
                                                     tabindex="@(seat.IsOccupied ? "-1" : "0")"
                                                     aria-label="Ghế @seat.Code@(seat.IsOccupied ? " đã có người đặt" : " - trống")"
                                                     aria-pressed="false"
                                                     title="@(seat.IsOccupied ? $"Ghế {seat.Code} đã có người đặt" : $"Ghế {seat.Code} - Click để chọn")">
                                                    <span>@seat.Code</span>
                                                    @if (seat.IsOccupied)
                                                    {
                                                        <small><i class="bi bi-lock-fill"></i></small>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: PASSENGER INFO & CHECKOUT -->
            <div class="col-12 col-lg-5">
                <!-- PICKUP/DROPOFF STATIONS -->
                <div class="gtrans-card mb-4">
                    <div class="p-4 border-bottom">
                        <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-geo-alt-fill text-futa"></i> Điểm đón & trả khách
                        </h5>
                    </div>
                    <div class="p-4">
                        <div class="mb-4">
                            <label asp-for="PickupStationId" class="form-label-modern">
                                <i class="bi bi-geo-alt-fill text-danger"></i> ĐIỂM ĐÓN KHÁCH <span class="text-danger">*</span>
                            </label>
                            <select asp-for="PickupStationId" class="form-select form-select-modern w-100" id="selectPickupStation">
                                @foreach (var station in Model.PickupStations)
                                {
                                    <option value="@station.StationId" data-name="@station.Name" data-address="@station.Address"
                                            selected="@(station.StationId == Model.PickupStationId ? "selected" : null)">
                                        @station.Name
                                    </option>
                                }
                            </select>
                            <div class="mt-2 p-2.5 rounded-3 border d-flex align-items-start gap-2" id="pickupStationPreview" style="background-color: #F8FAFC;">
                                <i class="bi bi-geo-alt-fill text-danger mt-1 flex-shrink-0 fs-6"></i>
                                <div style="min-width: 0;">
                                    <div class="fw-bold text-dark small" id="pickupStationNameText"></div>
                                    <div class="text-muted small mt-0.5 text-wrap" id="pickupStationAddressText" style="word-break: break-word; line-height: 1.4;"></div>
                                </div>
                            </div>
                            <span asp-validation-for="PickupStationId" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="mb-0">
                            <label asp-for="DropoffStationId" class="form-label-modern">
                                <i class="bi bi-flag-fill text-warning"></i> ĐIỂM TRẢ KHÁCH <span class="text-danger">*</span>
                            </label>
                            <select asp-for="DropoffStationId" class="form-select form-select-modern w-100" id="selectDropoffStation">
                                @foreach (var station in Model.DropoffStations)
                                {
                                    <option value="@station.StationId" data-name="@station.Name" data-address="@station.Address"
                                            selected="@(station.StationId == Model.DropoffStationId ? "selected" : null)">
                                        @station.Name
                                    </option>
                                }
                            </select>
                            <div class="mt-2 p-2.5 rounded-3 border d-flex align-items-start gap-2" id="dropoffStationPreview" style="background-color: #F8FAFC;">
                                <i class="bi bi-flag-fill text-warning mt-1 flex-shrink-0 fs-6"></i>
                                <div style="min-width: 0;">
                                    <div class="fw-bold text-dark small" id="dropoffStationNameText"></div>
                                    <div class="text-muted small mt-0.5 text-wrap" id="dropoffStationAddressText" style="word-break: break-word; line-height: 1.4;"></div>
                                </div>
                            </div>
                            <span asp-validation-for="DropoffStationId" class="text-danger small d-block mt-1"></span>
                        </div>
                    </div>
                </div>

                <!-- PASSENGER INFO -->
                <div class="gtrans-card mb-4">
                    <div class="p-4 border-bottom">
                        <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-person-fill text-futa"></i> Thông tin hành khách
                        </h5>
                    </div>
                    <div class="p-4">
                        <div class="mb-3">
                            <label asp-for="PassengerName" class="form-label-modern">
                                <i class="bi bi-person-badge"></i> HỌ VÀ TÊN <span class="text-danger">*</span>
                            </label>
                            <input asp-for="PassengerName" class="form-control-modern" placeholder="Nguyễn Văn A" autocomplete="name" />
                            <span asp-validation-for="PassengerName" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="mb-0">
                            <label asp-for="PassengerPhone" class="form-label-modern">
                                <i class="bi bi-telephone-fill"></i> SỐ ĐIỆN THOẠI <span class="text-danger">*</span>
                            </label>
                            <input asp-for="PassengerPhone" class="form-control-modern" placeholder="0912 345 678" autocomplete="tel" />
                            <span asp-validation-for="PassengerPhone" class="text-danger small d-block mt-1"></span>
                        </div>
                    </div>
                </div>

                <!-- DESKTOP STICKY CHECKOUT CARD -->
                <div class="sticky-checkout-card d-none d-lg-block">
                    <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom d-flex align-items-center gap-2">
                        <i class="bi bi-receipt text-futa"></i> Tóm tắt đặt vé
                    </h6>

                    <div class="mb-3 p-3 rounded-3 bg-slate-50">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small">Ghế đã chọn:</span>
                            <strong class="text-futa" id="desktopSelectedSeatsText">Chưa chọn ghế nào</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Tổng tạm tính:</span>
                            <span class="price-text-v2" id="desktopTotalPrice">0 đ</span>
                        </div>
                    </div>

                    <div id="noSeatAlertDesktop" class="alert alert-warning py-2 small mb-3 d-none rounded-3" style="background: #FFFDF5; border-color: #FED7AA;">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Vui lòng chọn ít nhất 1 ghế trước khi tiếp tục.
                    </div>

                    <button type="submit" class="btn btn-futa w-100 py-3.5 fs-5 fw-bold shadow-lg rounded-pill d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-shield-check fs-4"></i>
                        <span>XÁC NHẬN & GIỮ CHỖ (10 PHÚT)</span>
                    </button>

                    <div class="text-center mt-3">
                        <small class="text-muted d-flex align-items-center justify-content-center gap-1">
                            <i class="bi bi-shield-lock-fill text-success"></i>
                            <span>Thanh toán an toàn qua VNPay • Hủy miễn phí trước 4h</span>
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- MOBILE FLOATING STICKY BAR -->
        <div class="floating-bar-v2 d-lg-none">
            <div class="d-flex justify-content-between align-items-center">
                <div id="noSeatAlertMobile" class="alert alert-warning py-1.5 small px-3 mb-2 d-none w-100 text-center rounded-3" style="background: #FFFDF5; border-color: #FED7AA;">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Vui lòng chọn ít nhất 1 ghế.
                </div>
                <div class="d-flex justify-content-between align-items-center w-100">
                    <div>
                        <small class="text-muted d-block" id="mobileSelectedSeatsText">Chưa chọn ghế</small>
                        <span class="price-text-v2" id="mobileTotalPrice">0 đ</span>
                    </div>
                    <button type="submit" class="btn btn-futa py-2.5 px-5 shadow-lg rounded-pill fw-bold d-flex align-items-center gap-2">
                        TIẾP TỤC <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const basePrice = @Model.BasePrice;
            const maxSeats = 5;
            let selectedSeats = [];

            // Restore previously selected seats from ModelState
            const initialSeats = '@Model.SelectedSeats';
            if (initialSeats) {
                selectedSeats = initialSeats.split(',').map(s => s.trim().toUpperCase()).filter(s => s.length > 0);
            }

            const seatButtons = document.querySelectorAll('.seat-btn');
            const hiddenInput = document.getElementById('selectedSeatsInput');
            const seatCountBadge = document.getElementById('seatCountBadge');
            const desktopSeatsText = document.getElementById('desktopSelectedSeatsText');
            const desktopTotalPrice = document.getElementById('desktopTotalPrice');
            const mobileSeatsText = document.getElementById('mobileSelectedSeatsText');
            const mobileTotalPrice = document.getElementById('mobileTotalPrice');

            function updateUI() {
                // Sync class and aria-pressed on all seat buttons
                seatButtons.forEach(btn => {
                    const code = btn.getAttribute('data-seat-code');
                    const isOccupied = btn.getAttribute('data-occupied') === 'true';

                    if (!isOccupied) {
                        const isSel = selectedSeats.includes(code);
                        btn.setAttribute('aria-pressed', isSel ? 'true' : 'false');
                        if (isSel) {
                            btn.classList.add('selected');
                            btn.classList.remove('available');
                        } else {
                            btn.classList.remove('selected');
                            btn.classList.add('available');
                        }
                    }
                });

                // Hide warnings when seats selected
                if (selectedSeats.length > 0) {
                    const alertDesk = document.getElementById('noSeatAlertDesktop');
                    const alertMob = document.getElementById('noSeatAlertMobile');
                    if (alertDesk) alertDesk.classList.add('d-none');
                    if (alertMob) alertMob.classList.add('d-none');
                }

                // Update hidden input
                hiddenInput.value = selectedSeats.join(',');

                // Update display
                const count = selectedSeats.length;
                if (seatCountBadge) seatCountBadge.innerText = `Đã chọn: ${count}/${maxSeats}`;

                const formattedSeats = count > 0 ? selectedSeats.join(', ') : 'Chưa chọn ghế nào';
                const formattedPrice = (count * basePrice).toLocaleString('vi-VN') + ' đ';

                if (desktopSeatsText) desktopSeatsText.innerText = formattedSeats;
                if (desktopTotalPrice) desktopTotalPrice.innerText = formattedPrice;
                if (mobileSeatsText) mobileSeatsText.innerText = count > 0 ? `Ghế: ${formattedSeats}` : 'Chưa chọn ghế';
                if (mobileTotalPrice) mobileTotalPrice.innerText = formattedPrice;
            }

            // Seat click handlers
            seatButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const isOccupied = this.getAttribute('data-occupied') === 'true';
                    if (isOccupied) return;

                    const code = this.getAttribute('data-seat-code');
                    const index = selectedSeats.indexOf(code);

                    if (index > -1) {
                        // Deselect
                        selectedSeats.splice(index, 1);
                    } else {
                        // Check limit 5 seats
                        if (selectedSeats.length >= maxSeats) {
                            alert('Mỗi hành khách chỉ được chọn tối đa 5 ghế trong một lượt đặt vé!');
                            return;
                        }
                        selectedSeats.push(code);
                    }

                    updateUI();
                });

                // Keyboard support
                btn.addEventListener('keydown', function (e) {
                    if (e.key === ' ' || e.key === 'Enter') {
                        e.preventDefault();
                        this.click();
                    }
                });
            });

            // Form submit validation
            const bookingForm = document.getElementById('bookingForm');
            if (bookingForm) {
                bookingForm.addEventListener('submit', function (e) {
                    if (selectedSeats.length === 0) {
                        e.preventDefault();
                        const alertDesk = document.getElementById('noSeatAlertDesktop');
                        const alertMob = document.getElementById('noSeatAlertMobile');
                        if (alertDesk) alertDesk.classList.remove('d-none');
                        if (alertMob) alertMob.classList.remove('d-none');

                        // Scroll to seat map on mobile
                        const seatContainer = document.querySelector('.gtrans-card');
                        if (seatContainer) {
                            seatContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }
                    }
                });
            }

            // Sync station info card
            function syncStationPreview(selectEl, nameEl, addressEl) {
                if (!selectEl || !nameEl || !addressEl) return;
                const opt = selectEl.options[selectEl.selectedIndex];
                if (opt) {
                    nameEl.innerText = opt.getAttribute('data-name') || opt.text || '';
                    addressEl.innerText = opt.getAttribute('data-address') || '';
                }
            }

            const selPickup = document.getElementById('selectPickupStation');
            const pickupName = document.getElementById('pickupStationNameText');
            const pickupAddr = document.getElementById('pickupStationAddressText');
            if (selPickup) {
                syncStationPreview(selPickup, pickupName, pickupAddr);
                selPickup.addEventListener('change', () => syncStationPreview(selPickup, pickupName, pickupAddr));
            }

            const selDropoff = document.getElementById('selectDropoffStation');
            const dropoffName = document.getElementById('dropoffStationNameText');
            const dropoffAddr = document.getElementById('dropoffStationAddressText');
            if (selDropoff) {
                syncStationPreview(selDropoff, dropoffName, dropoffAddr);
                selDropoff.addEventListener('change', () => syncStationPreview(selDropoff, dropoffName, dropoffAddr));
            }

            // Initial UI sync
            updateUI();
        });
    </script>
}