@model WebVanTai.Models.ViewModels.TripBookingViewModel
@{
    ViewData["Title"] = $"Chọn ghế - {Model.StartProvince} đi {Model.EndProvince}";
}

<style>
    :root {
        --futa-orange: #F26522;
        --futa-dark-orange: #d9531e;
        --futa-light-orange: #fff2eb;
        --seat-available-border: #F26522;
        --seat-selected-bg: #F26522;
        --seat-occupied-bg: #e2e8f0;
        --seat-occupied-color: #94a3b8;
    }

    .booking-header {
        background: linear-gradient(135deg, var(--futa-orange), #ff7e40);
        color: white;
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 24px;
        box-shadow: 0 4px 15px rgba(242, 101, 34, 0.2);
    }

    .route-badge {
        background: rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(4px);
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
    }

    .bus-container {
        background: #f8fafc;
        border: 2px dashed #cbd5e1;
        border-radius: 24px;
        padding: 20px;
        position: relative;
    }

    .bus-driver {
        background: #e2e8f0;
        border-radius: 12px;
        padding: 8px 16px;
        text-align: center;
        font-size: 0.85rem;
        font-weight: 600;
        color: #475569;
        margin-bottom: 20px;
    }

    .seat-grid {
        display: grid;
        gap: 12px;
        justify-content: center;
        margin: 0 auto;
    }

    .seat-btn {
        width: 58px;
        height: 58px;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        user-select: none;
        position: relative;
    }

    .seat-btn.available {
        background: #ffffff;
        border: 2px solid var(--seat-available-border);
        color: var(--futa-orange);
        box-shadow: 0 2px 5px rgba(0,0,0,0.04);
    }

    .seat-btn.available:hover {
        background: var(--futa-light-orange);
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(242, 101, 34, 0.15);
    }

    .seat-btn.selected {
        background: var(--seat-selected-bg);
        border: 2px solid var(--futa-dark-orange);
        color: #ffffff;
        transform: scale(1.05);
        box-shadow: 0 4px 12px rgba(242, 101, 34, 0.4);
    }

    .seat-btn.occupied {
        background: var(--seat-occupied-bg);
        border: 2px solid #cbd5e1;
        color: var(--seat-occupied-color);
        cursor: not-allowed;
        opacity: 0.8;
    }

    .seat-legend {
        display: flex;
        justify-content: center;
        gap: 18px;
        flex-wrap: wrap;
        padding: 12px;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        margin-bottom: 20px;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .legend-box {
        width: 22px;
        height: 22px;
        border-radius: 6px;
    }

    .floating-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: #ffffff;
        box-shadow: 0 -4px 20px rgba(0,0,0,0.1);
        padding: 14px 20px;
        z-index: 1040;
    }

    .price-text {
        color: var(--futa-orange);
        font-weight: 800;
        font-size: 1.25rem;
    }

    .btn-futa {
        background: var(--futa-orange);
        border: none;
        color: white;
        font-weight: 700;
        border-radius: 12px;
        padding: 12px 24px;
        transition: all 0.2s;
    }

    .btn-futa:hover {
        background: var(--futa-dark-orange);
        color: white;
        transform: translateY(-1px);
    }

    /* Padding for floating bar */
    .pb-floating {
        padding-bottom: 100px;
    }
</style>

<div class="container pb-floating py-3">
    <!-- Header Thông tin chuyến -->
    <div class="booking-header">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <div>
                <span class="route-badge mb-2 d-inline-block">Tuyến xe</span>
                <h3 class="fw-bold mb-0">@Model.StartProvince <i class="bi bi-arrow-right"></i> @Model.EndProvince</h3>
            </div>
            <div class="text-end">
                <div class="route-badge">@Model.BusTypeName</div>
                <small class="d-block mt-1 text-white-50">Biển số: @Model.LicensePlate</small>
            </div>
        </div>
        <hr class="my-2 border-white opacity-25" />
        <div class="row g-2 mt-1">
            <div class="col-6 col-md-3">
                <small class="text-white-50 d-block">Khởi hành</small>
                <strong>@Model.DepartureTime.ToString("HH:mm - dd/MM/yyyy")</strong>
            </div>
            <div class="col-6 col-md-3">
                <small class="text-white-50 d-block">Đến dự kiến</small>
                <strong>@Model.ArrivalTime.ToString("HH:mm - dd/MM/yyyy")</strong>
            </div>
            <div class="col-12 col-md-6 text-md-end">
                <small class="text-white-50 d-block">Giá vé niêm yết</small>
                <span class="fs-5 fw-bold">@Model.BasePrice.ToString("N0") đ / vé</span>
            </div>
        </div>
    </div>

    <!-- Alert thông báo lỗi -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <h6 class="fw-bold mb-2"><i class="bi bi-exclamation-triangle-fill"></i> Có lỗi xảy ra:</h6>
            <div asp-validation-summary="All" class="text-danger mb-0 small"></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Chú thích ghế (Legend) -->
    <div class="seat-legend">
        <div class="legend-item">
            <div class="legend-box" style="border: 2px solid var(--seat-available-border); background: #fff;"></div>
            <span>Ghế trống</span>
        </div>
        <div class="legend-item">
            <div class="legend-box" style="background: var(--seat-selected-bg);"></div>
            <span>Đang chọn (tối đa 5)</span>
        </div>
        <div class="legend-item">
            <div class="legend-box" style="background: var(--seat-occupied-bg); border: 2px solid #cbd5e1;"></div>
            <span>Đã đặt / Đang giữ chỗ</span>
        </div>
    </div>

    <form asp-action="BookSeats" method="post" id="bookingForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="TripId" />
        <input type="hidden" asp-for="SelectedSeats" id="selectedSeatsInput" />

        <div class="row g-4">
            <!-- Cột chọn ghế (Responsive 2 tầng) -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 pt-3 px-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold text-dark mb-0">Sơ đồ vị trí ghế ngồi</h5>
                            <span class="badge bg-light text-dark border" id="seatCountBadge">Đã chọn: 0/5</span>
                        </div>
                    </div>
                    <div class="card-body px-4 pb-4">
                        @if (Model.Decks.Count > 1)
                        {
                            <!-- Tab điều hướng 2 tầng trên thiết bị di động -->
                            <ul class="nav nav-pills nav-fill mb-3 d-md-none" id="deckTabs" role="tablist">
                                @for (int i = 0; i < Model.Decks.Count; i++)
                                {
                                    var deck = Model.Decks[i];
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link @(i == 0 ? "active" : "") fw-bold py-2" 
                                                id="tab-deck-@deck.DeckNumber" 
                                                data-bs-toggle="pill" 
                                                data-bs-target="#deck-content-@deck.DeckNumber" 
                                                type="button" 
                                                role="tab">
                                            @deck.DeckName
                                        </button>
                                    </li>
                                }
                            </ul>
                        }

                        <div class="tab-content row g-4" id="deckTabsContent">
                            @for (int i = 0; i < Model.Decks.Count; i++)
                            {
                                var deck = Model.Decks[i];
                                <div class="tab-pane fade @(i == 0 ? "show active" : "") col-md-6 d-md-block" 
                                     id="deck-content-@deck.DeckNumber" 
                                     role="tabpanel">
                                    <div class="bus-container">
                                        <div class="bus-driver">
                                            <i class="bi bi-steering-wheel"></i> Vị trí Bác Tài (@deck.DeckName)
                                        </div>
                                        <div class="seat-grid" style="grid-template-columns: repeat(@deck.Cols, 58px);">
                                            @foreach (var seat in deck.Seats)
                                            {
                                                var isOccupiedClass = seat.IsOccupied ? "occupied" : "available";
                                                <div class="seat-btn @isOccupiedClass" 
                                                     data-seat-code="@seat.Code" 
                                                     data-occupied="@(seat.IsOccupied ? "true" : "false")"
                                                     title="@(seat.IsOccupied ? $"Ghế {seat.Code} đã có người đặt" : $"Ghế {seat.Code}")">
                                                    <span>@seat.Code</span>
                                                    @if (seat.IsOccupied)
                                                    {
                                                        <small style="font-size: 0.65rem;"><i class="bi bi-lock-fill"></i></small>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột thông tin hành khách & Điểm đón trả -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-3 px-4">
                        <h5 class="fw-bold text-dark mb-0">Điểm đón và trả</h5>
                    </div>
                    <div class="card-body px-4 pb-4">
                        <div class="mb-3">
                            <label asp-for="PickupStationId" class="form-label fw-bold small text-muted">ĐIỂM ĐÓN KHÁCH</label>
                            <select asp-for="PickupStationId" class="form-select form-select-lg rounded-3 fs-6">
                                @foreach (var station in Model.PickupStations)
                                {
                                    <option value="@station.StationId">@station.Name - @station.Address</option>
                                }
                            </select>
                            <span asp-validation-for="PickupStationId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DropoffStationId" class="form-label fw-bold small text-muted">ĐIỂM TRẢ KHÁCH</label>
                            <select asp-for="DropoffStationId" class="form-select form-select-lg rounded-3 fs-6">
                                @foreach (var station in Model.DropoffStations)
                                {
                                    <option value="@station.StationId">@station.Name - @station.Address</option>
                                }
                            </select>
                            <span asp-validation-for="DropoffStationId" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-3 px-4">
                        <h5 class="fw-bold text-dark mb-0">Thông tin người liên hệ</h5>
                    </div>
                    <div class="card-body px-4 pb-4">
                        <div class="mb-3">
                            <label asp-for="PassengerName" class="form-label fw-bold small text-muted">HỌ VÀ TÊN HÀNH KHÁCH <span class="text-danger">*</span></label>
                            <input asp-for="PassengerName" class="form-control form-control-lg rounded-3 fs-6" placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="PassengerName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PassengerPhone" class="form-label fw-bold small text-muted">SỐ ĐIỆN THOẠI NHẬN VÉ <span class="text-danger">*</span></label>
                            <input asp-for="PassengerPhone" class="form-control form-control-lg rounded-3 fs-6" placeholder="0912345678" />
                            <span asp-validation-for="PassengerPhone" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Tóm tắt chi phí trên màn hình lớn -->
                <div class="card border-0 shadow-sm rounded-4 d-none d-lg-block">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Ghế đã chọn:</span>
                            <strong id="desktopSelectedSeatsText">Chưa chọn ghế nào</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-muted">Tổng tạm tính:</span>
                            <span class="price-text" id="desktopTotalPrice">0 đ</span>
                        </div>
                        <button type="submit" class="btn btn-futa w-100 py-3 fs-6 shadow">
                            <i class="bi bi-shield-check"></i> Xác nhận & Giữ chỗ (10 phút)
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thanh nổi cố định chân màn hình cho thiết bị di động (Floating Mobile Sticky Bar) -->
        <div class="floating-bar d-lg-none">
            <div class="container p-0">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <small class="text-muted d-block" id="mobileSelectedSeatsText">Chưa chọn ghế</small>
                        <span class="price-text fs-5" id="mobileTotalPrice">0 đ</span>
                    </div>
                    <div>
                        <button type="submit" class="btn btn-futa py-2 px-4 shadow">
                            Tiếp tục <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const basePrice = @Model.BasePrice;
            const maxSeats = 5;
            let selectedSeats = [];

            // Phục hồi ghế đã chọn nếu có từ ModelState
            const initialSeats = '@Model.SelectedSeats';
            if (initialSeats) {
                selectedSeats = initialSeats.split(',').map(s => s.trim().toUpperCase()).filter(s => s.length > 0);
            }

            const seatButtons = document.querySelectorAll('.seat-btn');
            const hiddenInput = document.getElementById('selectedSeatsInput');
            const seatCountBadge = document.getElementById('seatCountBadge');
            const desktopSeatsText = document.getElementById('desktopSelectedSeatsText');
            const desktopTotalPrice = document.getElementById('desktopTotalPrice');
            const mobileSeatsText = document.getElementById('mobileSelectedSeatsText');
            const mobileTotalPrice = document.getElementById('mobileTotalPrice');

            function updateUI() {
                // Đồng bộ class trên tất cả các nút ghế
                seatButtons.forEach(btn => {
                    const code = btn.getAttribute('data-seat-code');
                    const isOccupied = btn.getAttribute('data-occupied') === 'true';

                    if (!isOccupied) {
                        if (selectedSeats.includes(code)) {
                            btn.classList.add('selected');
                            btn.classList.remove('available');
                        } else {
                            btn.classList.remove('selected');
                            btn.classList.add('available');
                        }
                    }
                });

                // Cập nhật giá trị input
                hiddenInput.value = selectedSeats.join(',');

                // Cập nhật số lượng và nhãn hiển thị
                const count = selectedSeats.length;
                seatCountBadge.innerText = `Đã chọn: ${count}/${maxSeats}`;

                const formattedSeats = count > 0 ? selectedSeats.join(', ') : 'Chưa chọn ghế nào';
                const formattedPrice = (count * basePrice).toLocaleString('vi-VN') + ' đ';

                if (desktopSeatsText) desktopSeatsText.innerText = formattedSeats;
                if (desktopTotalPrice) desktopTotalPrice.innerText = formattedPrice;
                if (mobileSeatsText) mobileSeatsText.innerText = count > 0 ? `Ghế: ${formattedSeats}` : 'Chưa chọn ghế';
                if (mobileTotalPrice) mobileTotalPrice.innerText = formattedPrice;
            }

            // Gán sự kiện click cho từng ghế
            seatButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const isOccupied = this.getAttribute('data-occupied') === 'true';
                    if (isOccupied) {
                        return;
                    }

                    const code = this.getAttribute('data-seat-code');
                    const index = selectedSeats.indexOf(code);

                    if (index > -1) {
                        // Bỏ chọn
                        selectedSeats.splice(index, 1);
                    } else {
                        // Kiểm tra giới hạn 5 ghế
                        if (selectedSeats.length >= maxSeats) {
                            alert('Mỗi hành khách chỉ được chọn tối đa 5 ghế trong một lượt đặt vé!');
                            return;
                        }
                        selectedSeats.push(code);
                    }

                    updateUI();
                });
            });

            // Khởi chạy cập nhật trạng thái ban đầu
            updateUI();
        });
    </script>
}

